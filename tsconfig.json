{
  "extends": "astro/tsconfigs/strict",
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "astro.config.mjs"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["astro/client"],
    "skipLibCheck": true
  }
}
