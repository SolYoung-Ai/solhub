# SolHub × CloudBase 配置示例
# 复制为 .env 并填入真实值（PUBLISHABLE_KEY 在 CloudBase 控制台 → 环境 → 认证设置获取，
# 或由具备权限的管理端执行 ensurePublishableKey 生成。它是 anon 公开身份，可暴露给浏览器；
# 严禁放置 API Key / SecretKey / service_role 凭据）。

PUBLIC_CLOUDBASE_ENV_ID=
PUBLIC_CLOUDBASE_PUBLISHABLE_KEY=

# 登录与「我的提交」的认证服务地址（CloudBase HTTP Function，2026-11-02 起）
# 2026-11-02 之前后端是 Cloudflare Worker（solhub-auth.solyoung.top），因免费版没有中国 PoP，
# 国内访问 TTFB 3.8~13.2 秒，登录与个人主页经常超时，已整体迁到 CloudBase 上海（实测 0.13 秒）。
# 网关路由挂在 /api 前缀下，所以基址自带 /api，后面拼 /me、/auth/login 等路径。
# 留空则回退到 src/lib/api-base.ts 里的默认地址（即上面这个 CloudBase 地址）。
PUBLIC_SOLHUB_API=

# ===== Google AdSense（可选，默认关闭）=====
# 留空 = 全站零广告：不加载 AdSense 脚本、不渲染广告位、隐私页也不声明广告。
# 过审后填 ca-pub-xxxxxxxxxxxxxxxx，再用 npm run ads:init 生成 ads.txt。
PUBLIC_ADSENSE_CLIENT=
# 广告单元 id（纯数字）。在 AdSense 后台「广告 → 按广告单元」里创建：
#   ARTICLE 给产品详情页（文内），LIST 给 Skill 库 / 产品列表页底部。
PUBLIC_ADSENSE_SLOT_ARTICLE=
PUBLIC_ADSENSE_SLOT_LIST=
