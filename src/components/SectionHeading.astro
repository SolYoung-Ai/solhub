---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { eyebrow, title, description, actionHref, actionLabel } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div class="max-w-2xl">
    {
      eyebrow && (
        <p class="mb-1 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">
          {eyebrow}
        </p>
      )
    }
    <h2 class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-[28px]">
      {title}
    </h2>
    {
      description && (
        <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
      )
    }
  </div>
  {
    actionHref && actionLabel && (
      <a
        href={actionHref}
        class="btn btn-outline !h-8 text-[13px]"
      >
        {actionLabel}
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>
