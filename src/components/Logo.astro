---
interface Props {
  size?: number;
  withText?: boolean;
  textClass?: string;
  markOnly?: boolean;
}

const { size = 22, withText = true, textClass = "", markOnly = false } = Astro.props;
---

<span class="inline-flex items-center gap-2 leading-none" aria-label="SolHub">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.4" opacity="0.35" />
    <line x1="16" y1="16" x2="9.4" y2="9.4" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <line x1="16" y1="16" x2="22.6" y2="22.6" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <line x1="16" y1="16" x2="23.9" y2="11.7" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <circle cx="16" cy="16" r="4.4" fill="var(--color-accent)" />
    <circle cx="9.4" cy="9.4" r="2" fill="currentColor" />
    <circle cx="22.6" cy="22.6" r="2" fill="currentColor" />
    <circle cx="23.9" cy="11.7" r="1.6" fill="var(--color-accent)" />
  </svg>
  {
    withText && !markOnly && (
      <span
        class:list={[
          "font-display text-[17px] font-bold tracking-tight text-foreground",
          textClass,
        ]}
      >
        SolHub
      </span>
    )
  }
</span>
