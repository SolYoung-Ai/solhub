---
/**
 * 赞助位／广告墙（/sponsors/）
 *
 * 与入驻页的分工：
 * - 这里：所有在售广告，按出价排名，可搜索；点卡片进各自独立页
 * - /sponsors/join/：怎么出价、素材要求、邮件模板
 *
 * 与产品目录的区别（也是这页存在的理由）：产品谁都能提交，这里卖的是注意力。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdsBoard from "@/islands/AdsBoard.tsx";
import { ADS, AD_DAYS } from "@/data/ads";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";
const joinHref = p("/sponsors/join/", locale);

/* 构建时间同时传给 island，保证 SSR 与首帧渲染结果一致 */
const builtAt = new Date().toISOString();

const metaDesc = en
  ? "SolHub sponsor slots: bid any amount, ranked by bid, one ad card for 30 days. Ads only — searchable, each with its own shareable page."
  : "SolHub 赞助位：自由出价、按金额排名、展示 30 天。只放广告，可搜索，每条广告都有可分享的独立页面。";

const copy = en
  ? {
      eyebrow: "Sponsored placements",
      title: "This space can promote anything",
      lede: "Not another product listing — anyone can submit a product for free. What you buy here is attention: one card, ranked by how much you bid, in front of people who are already browsing tools.",
      chips: ["Ranked by bid", "30 days, then it drops off", "Reviewed by a human"],
      boardTitle: "Current ads",
      boardNote: "One card per sponsor. Highest bid first.",
      rulesTitle: "How it works",
      rules: [
        { t: "Bid, don't pick a tier", d: "There are no packages. Name a number, and the card is ranked against everyone else's." },
        { t: "30 days, automatic", d: "The card goes up the day payment clears and drops off on day 30 — no renewal awkwardness, no auto-charge." },
        { t: "One card, one page", d: "Every ad gets its own page you can share, so a link in a group chat sends people straight to it." },
      ],
      refuseTitle: "Not accepted",
      refuse: [
        "Gambling, lending, crypto speculation, get-rich courses",
        "Anything that needs a download to “unlock” what was advertised",
        "SEO farms, link directories, pages that are not a real thing",
        "Adult content, or anything a reader would not open at work",
      ],
      ctaTitle: "Want this slot?",
      ctaBody: "Send a bid by email. Reply within 24 hours, card live the same day once it clears.",
      cta: "How to bid",
    }
  : {
      eyebrow: "赞助位",
      title: "这个位置可以宣传任何东西",
      lede: "它不是产品目录的第二份——产品谁都能免费提交。这里卖的是注意力：一张卡，按你出的价排名，摆在正在逛工具的人眼前。",
      chips: ["按出价排名", "展示 30 天自动下架", "人工审核后上线"],
      boardTitle: "当前广告",
      boardNote: "一家一张卡，出价高的在前。",
      rulesTitle: "怎么运作",
      rules: [
        { t: "出价，不选套餐", d: "没有档位。你说一个数，卡片就按这个数和其他人的出价排队。" },
        { t: "30 天，自动下架", d: "付款到账当天上线，第 30 天自动撤下——没有自动续费，也不用你记得来取消。" },
        { t: "一张卡，一个独立页", d: "每条广告都有自己的页面，可以直接分享，丢进群里点开就是它。" },
      ],
      refuseTitle: "不接这些",
      refuse: [
        "博彩、借贷、币圈投机、「教你暴富」类课程",
        "要先下载才能「解锁」所宣传内容的东西",
        "SEO 站群、链接目录、背后不是真产品的页面",
        "成人内容，或任何让人在办公室不敢点开的东西",
      ],
      ctaTitle: "想要这个位置？",
      ctaBody: "发邮件出价，24 小时内回复；到账当天上线。",
      cta: "怎么出价",
    };
---

<BaseLayout title={en ? "Sponsors" : "赞助商"} description={metaDesc} route="/sponsors/" locale={locale}>
  <section class="border-b border-border bg-secondary/30 py-9 sm:py-12">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold tracking-[0.22em] text-accent uppercase">
        {copy.eyebrow}
      </p>
      <h1 class="max-w-3xl font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {copy.title}
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">{copy.lede}</p>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        {
          copy.chips.map((chip) => (
            <span class="rounded-full border border-border bg-card px-2.5 py-1 text-[11px] text-muted-foreground">
              {chip}
            </span>
          ))
        }
        <a href={joinHref} class="btn btn-accent !h-9 px-4 text-xs">{en ? "Book a slot" : "我要投广告"}</a>
      </div>

      <p class="mt-4 text-[11px] leading-5 text-muted-foreground/80">
        {en
          ? `Each card runs ${AD_DAYS} days from the day it goes up, then drops off on its own.`
          : `每条广告从上线当天起算 ${AD_DAYS} 天，到期自动撤下——不用谁记得来取消。`}
      </p>
    </div>
  </section>

  <section class="py-8 sm:py-10">
    <div class="container-page">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{copy.boardTitle}</h2>
        <p class="text-[11px] text-muted-foreground">{copy.boardNote}</p>
      </div>

      <AdsBoard client:load ads={ADS} builtAt={builtAt} locale={locale} joinHref={joinHref} />
    </div>
  </section>

  <section class="border-t border-border bg-secondary/20 py-9 sm:py-11">
    <div class="container-page">
      <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{copy.rulesTitle}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          copy.rules.map((rule, i) => (
            <div class="rounded-[14px] border border-border bg-card p-4">
              <p class="font-mono text-[10px] tracking-[0.16em] text-muted-foreground/70">0{i + 1}</p>
              <p class="mt-1.5 text-[13px] font-bold text-foreground">{rule.t}</p>
              <p class="mt-1 text-[12px] leading-6 text-muted-foreground">{rule.d}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-5 rounded-[16px] border border-border bg-card p-5">
        <p class="flex items-center gap-2 text-[12px] font-bold text-warning">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
          {copy.refuseTitle}
        </p>
        <ul class="mt-2.5 grid gap-1.5 sm:grid-cols-2">
          {copy.refuse.map((item) => <li class="text-[12px] leading-6 text-muted-foreground">· {item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-9 sm:py-11">
    <div class="container-page">
      <div class="flex flex-col items-start justify-between gap-4 rounded-[18px] border border-border bg-card px-5 py-6 sm:flex-row sm:items-center sm:px-7">
        <div class="min-w-0">
          <p class="font-display text-lg font-extrabold tracking-tight text-foreground">{copy.ctaTitle}</p>
          <p class="mt-1 text-[12px] text-muted-foreground">{copy.ctaBody}</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-2">
          <a href={joinHref} class="btn btn-accent !h-10 px-5 text-sm">{copy.cta}</a>
          <a href={p("/", locale)} class="btn btn-outline !h-10 px-4 text-sm">{en ? "Back home" : "回到首页"}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
