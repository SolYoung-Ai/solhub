---
/**
 * 广告墙（/sponsors/）——纯访客视角
 *
 * 这里只回答访客的两个问题：这是什么、有哪些。
 * 出价、档期、审核标准、怎么买，全部在 /sponsors/join/（入口在账号菜单「赞助合作」），
 * 不放在访客页面上。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdsBoard from "@/islands/AdsBoard.tsx";
import { ADS } from "@/data/ads";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

/* 构建时间同时传给 island，保证 SSR 与首帧渲染结果一致 */
const builtAt = new Date().toISOString();

const metaDesc = en
  ? "Paid placements on SolHub, clearly labelled as ads. They never affect how products and Skills are ranked."
  : "SolHub 上的付费广告位，全部标注为广告；不影响产品与 Skill 的排序。";

const copy = en
  ? {
      eyebrow: "Advertising",
      title: "The ads that keep SolHub free",
      lede: "These are paid placements. They are labelled, ordered by how much was bid, and have nothing to do with our editorial picks — products and Skills are ranked exactly the same with or without them.",
      boardTitle: "Current ads",
      note: "Every card is marked “Sponsor” and “Ad”. Click one to see it on its own page.",
    }
  : {
      eyebrow: "广告",
      title: "让 SolHub 保持免费的那些广告",
      lede: "以下是付费广告位，全部标了「赞助商」和「广告」。它们与编辑推荐无关，也不会改变产品与 Skill 的排序——有没有这些广告，榜单都是同一套规则。",
      boardTitle: "当前广告",
      note: "每张卡片都同时标了「赞助商」和「广告」，点开是它自己的页面。",
    };
---

<BaseLayout title={en ? "Ads" : "广告"} description={metaDesc} route="/sponsors/" locale={locale}>
  <section class="border-b border-border bg-secondary/30 py-9 sm:py-12">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold tracking-[0.22em] text-accent uppercase">
        {copy.eyebrow}
      </p>
      <h1 class="max-w-3xl font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {copy.title}
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">{copy.lede}</p>
    </div>
  </section>

  <section class="py-8 sm:py-10">
    <div class="container-page">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{copy.boardTitle}</h2>
        <p class="max-w-lg text-[11px] leading-5 text-muted-foreground">{copy.note}</p>
      </div>

      <AdsBoard client:load ads={ADS} builtAt={builtAt} locale={locale} />
    </div>
  </section>
</BaseLayout>
