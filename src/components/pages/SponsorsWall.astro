---
/**
 * 广告墙（/sponsors/）——纯访客视角
 *
 * 这里只回答访客的两个问题：这是什么、有哪些。
 * 出价、档期、审核标准、怎么买，全部在 /sponsors/join/（入口在账号菜单「赞助合作」），
 * 不放在访客页面上。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdsBoard from "@/islands/AdsBoard.tsx";
import { ADS } from "@/data/ads";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

/* 构建时间同时传给 island，保证 SSR 与首帧渲染结果一致 */
const builtAt = new Date().toISOString();

const metaDesc = en
  ? "Sponsors on SolHub: paid placements, ordered by the amount sponsored. Product and Skill rankings are unchanged."
  : "SolHub 的赞助商：按赞助金额排序，全部标注为广告；产品与 Skill 的排序规则不变。";

const copy = en
  ? {
      eyebrow: "Advertising",
      title: "Sponsors",
      lede: "Sponsorship content on SolHub, ordered by the amount sponsored. The ranking rules for products and Skills stay exactly the same.",
      boardTitle: "Current sponsors",
    }
  : {
      eyebrow: "广告",
      title: "赞助商",
      lede: "下面是 SolHub 上的赞助内容，按照赞助金额排序，产品与 Skill 的排序规则都不变。",
      boardTitle: "当前赞助商",
    };
---

<BaseLayout title={en ? "Sponsors" : "赞助商"} description={metaDesc} route="/sponsors/" locale={locale}>
  <section class="border-b border-border bg-secondary/30 py-9 sm:py-12">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold tracking-[0.22em] text-accent uppercase">
        {copy.eyebrow}
      </p>
      <h1 class="max-w-3xl font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {copy.title}
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">{copy.lede}</p>
    </div>
  </section>

  <section class="py-8 sm:py-10">
    <div class="container-page">
      <h2 class="mb-4 font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{copy.boardTitle}</h2>

      <AdsBoard client:load ads={ADS} builtAt={builtAt} locale={locale} />
    </div>
  </section>
</BaseLayout>
