---
/**
 * 赞助合作（/sponsors/join/）——只有广告主会看到
 *
 * 刻意做短：一屏能读完的规则 + 一个大按钮 + 一份模板。
 * 繁琐的档位表、席位、推荐价全部删掉，只留「最低 10 元」一条线。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/data/site";
import { AD_DAYS, MIN_BID } from "@/data/ads";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";
const mail = siteConfig.sponsorEmail;
const wallHref = p("/sponsors/", locale);

const subject = en ? "Sponsor SolHub · <your name>" : "赞助 SolHub · <你的名称>";
const body = en
  ? `Hi,

I'd like to put a card on SolHub's sponsor wall.

1. Name (max 20 chars):
2. One line (max 40 chars):
3. Link:
4. Type (product / service / event / hiring / other):
5. Bid (CNY per 30 days, minimum ¥${MIN_BID}):
6. Preferred start date:
7. Logo: attached, or a download link

I confirm the link works and the thing advertised is real, and I understand the card runs 30 days and then drops off.

Thanks,
<your name>`
  : `你好，

我想在 SolHub 的赞助位上放一张卡片：

1. 名称（20 字以内）：
2. 一句话（40 字以内）：
3. 链接：
4. 类型（产品 / 服务 / 活动 / 招募 / 其他）：
5. 出价（元 / ${AD_DAYS} 天，最低 ${MIN_BID} 元）：
6. 希望开始日期：
7. Logo：附件，或可下载的地址

我确认链接可以打开、所宣传的内容真实存在，并了解卡片展示 ${AD_DAYS} 天后会自动下架。

谢谢
<你的名字>`;

const mailto = `mailto:${mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const metaDesc = en
  ? `Sponsor SolHub: bid from ¥${MIN_BID} per ${AD_DAYS} days, ranked by amount, reply within 24 hours. One email, template included.`
  : `在 SolHub 投放：最低 ${MIN_BID} 元 / ${AD_DAYS} 天，按金额排名，24 小时内回复。点一次按钮就能发邮件，模板已填好。`;

const copy = en
  ? {
      eyebrow: "Sponsorship",
      title: "Bid what you want. The wall sorts by amount.",
      lede: `Minimum ¥${MIN_BID} for ${AD_DAYS} days. Higher bids sit above lower ones, and the card drops off automatically on day ${AD_DAYS}. No packages, no contract.`,
      facts: [
        { v: `¥${MIN_BID}`, l: `minimum bid / ${AD_DAYS} days` },
        { v: `${AD_DAYS}d`, l: "then it comes down by itself" },
        { v: "24h", l: "reply window, every working day" },
      ],
      cta: "Become a sponsor",
      ctaNote: "On desktop this opens your mail app with the template filled in. On mobile it copies the address instead.",
      stepsTitle: "Three steps",
      steps: [
        { t: "1 Send the email", d: "The template is prefilled — just add name, link and your bid." },
        { t: "2 Get a reply", d: "Within 24 hours: slot confirmed, or a reason it can't run." },
        { t: "3 Pay, then live", d: "Transfer or Alipay. Card and its page go up the same day, 30 days on the clock." },
      ],
      tplTitle: "Email template",
      tplNote: "If your mail app didn't open, copy this by hand.",
      copyBtn: "Copy template",
      copied: "Copied",
      rulesTitle: "Not accepted",
      rules: "Gambling, lending, crypto speculation, get-rich courses · anything that needs a download to “unlock” · SEO farms and link directories · adult content.",
      promise: "A paid card never changes how products and Skills are ranked, and never buys a Verified mark or an editorial pick.",
      faqTitle: "Two questions",
      faq: [
        { q: "Can I change the copy mid-term?", a: "Yes, once, free — email the new text and it goes up the same day." },
        { q: "What happens on day 30?", a: "The card disappears and its link stops working. Bid again if you want it back." },
      ],
      backWall: "See current sponsors",
    }
  : {
      eyebrow: "赞助合作",
      title: "自由出价，按金额排名",
      lede: `最低 ${MIN_BID} 元 / ${AD_DAYS} 天。出价高的排在前面，到第 ${AD_DAYS} 天自动下架。没有套餐，也不用签合同。`,
      facts: [
        { v: `¥${MIN_BID}`, l: `最低出价 / ${AD_DAYS} 天` },
        { v: `${AD_DAYS} 天`, l: "到期自动下架" },
        { v: "24h", l: "内回复，每个工作日都看邮件" },
      ],
      cta: "成为赞助商",
      ctaNote: "电脑端会打开邮件客户端并填好模板；手机端会直接复制邮箱。",
      stepsTitle: "三步",
      steps: [
        { t: "1 发邮件", d: "模板已经填好，补上名称、链接和出价就行。" },
        { t: "2 等回复", d: "24 小时内回你：位置确认，或说明为什么不能上。" },
        { t: "3 付款上线", d: "转账或支付宝，到账当天上线，30 天开始计时。" },
      ],
      tplTitle: "邮件模板",
      tplNote: "邮件没自动打开的话，手动复制这段。",
      copyBtn: "复制模板",
      copied: "已复制",
      rulesTitle: "不接这些",
      rules: "博彩、借贷、币圈投机、「教你暴富」类课程 · 要先下载才能解锁的东西 · SEO 站群与链接目录 · 成人内容。",
      promise: "付费卡片不会改变产品与 Skill 的排序，也买不到 Verified 标记或编辑推荐。",
      faqTitle: "两个问题",
      faq: [
        { q: "中途能改文案吗？", a: "能，免费改一次：把新文案发我，当天替换。" },
        { q: "第 30 天会怎样？", a: "卡片自动消失，链接失效。想继续就重新出价。" },
      ],
      backWall: "看看现在的赞助商",
    };
---

<BaseLayout title={en ? "Sponsorship" : "赞助合作"} description={metaDesc} route="/sponsors/join/" locale={locale}>
  <section class="border-b border-border bg-secondary/30 py-9 sm:py-12">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold tracking-[0.22em] text-accent uppercase">
        {copy.eyebrow}
      </p>
      <h1 class="max-w-3xl font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {copy.title}
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">{copy.lede}</p>

      <dl class="mt-6 grid max-w-xl grid-cols-3 gap-2.5">
        {
          copy.facts.map((f) => (
            <div class="rounded-[14px] border border-border bg-card px-3 py-3 text-center sm:px-4">
              <dt class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{f.v}</dt>
              <dd class="mt-0.5 text-[10px] leading-4 text-muted-foreground sm:text-[11px]">{f.l}</dd>
            </div>
          ))
        }
      </dl>

      <!-- 全页唯一的大按钮：桌面走 mailto，手机复制邮箱（见页尾脚本） -->
      <div class="mt-7">
        <a
          id="sponsor-cta"
          href={mailto}
          class="btn btn-accent !h-13 w-full gap-2 px-8 text-[15px] font-bold shadow-[0_6px_18px_-6px_rgba(232,112,40,0.6)] sm:!h-14 sm:w-auto sm:min-w-[320px] sm:text-[17px]"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m2 7 10 6 10-6" />
          </svg>
          <span id="cta-label" data-label={copy.cta} data-copied={en ? "Address copied" : "邮箱已复制"}>{copy.cta}</span>
        </a>
        <p class="mt-2.5 max-w-xl text-[11px] leading-5 text-muted-foreground">
          {copy.ctaNote}
        </p>
        <p id="cta-fallback" class="mt-1 hidden font-mono text-[12px] font-semibold text-accent select-all">
          {mail}
        </p>
      </div>
    </div>
  </section>

  <!-- 三步 -->
  <section class="py-8 sm:py-10">
    <div class="container-page">
      <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{copy.stepsTitle}</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          copy.steps.map((step) => (
            <li class="rounded-[14px] border border-border bg-card p-4">
              <p class="text-[13px] font-bold text-foreground">{step.t}</p>
              <p class="mt-1 text-[12px] leading-5 text-muted-foreground">{step.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 邮件模板 -->
  <section class="border-t border-border bg-secondary/20 py-8 sm:py-10">
    <div class="container-page">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{copy.tplTitle}</h2>
        <p class="text-[11px] text-muted-foreground">{copy.tplNote}</p>
      </div>

      <div class="mt-4 overflow-hidden rounded-[16px] border border-border bg-card">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-4 py-2.5">
          <p class="font-mono text-[11px] text-muted-foreground">
            {en ? "To" : "发到"}：<span class="text-foreground">{mail}</span>
          </p>
          <button
            type="button"
            id="copy-tpl"
            data-copied={copy.copied}
            data-label={copy.copyBtn}
            class="btn btn-outline !h-8 px-3 text-[11px]"
          >
            {copy.copyBtn}
          </button>
        </div>
        <pre
          id="mail-template"
          class="max-h-[340px] overflow-auto px-4 py-3.5 font-mono text-[11.5px] leading-6 whitespace-pre-wrap text-foreground/85"
        >{`${en ? "Subject" : "主题"}：${subject}

${body}`}</pre>
      </div>

      <p class="mt-4 border-t border-border pt-3 text-[11px] leading-5 text-muted-foreground/80">
        <span class="font-semibold text-foreground">{copy.rulesTitle}：</span>{copy.rules}
      </p>
      <p class="mt-1.5 text-[11px] leading-5 text-muted-foreground/80">{copy.promise}</p>
    </div>
  </section>

  <!-- FAQ + 回链 -->
  <section class="py-8 sm:py-10">
    <div class="container-page max-w-3xl">
      <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">{copy.faqTitle}</h2>
      <div class="mt-4 divide-y divide-border overflow-hidden rounded-[16px] border border-border bg-card">
        {
          copy.faq.map((item) => (
            <details class="group px-4 py-3">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-[13px] font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                {item.q}
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <p class="mt-2 text-[12px] leading-6 text-muted-foreground">{item.a}</p>
            </details>
          ))
        }
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        <a href={wallHref} class="btn btn-outline !h-9 px-4 text-xs">{copy.backWall}</a>
        <a href={p("/", locale)} class="btn btn-outline !h-9 px-4 text-xs">{en ? "Back home" : "回到首页"}</a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ mail }}>
    (() => {
      const cta = document.getElementById("sponsor-cta");
      const fallback = document.getElementById("cta-fallback");
      const tplBtn = document.getElementById("copy-tpl");
      const pre = document.getElementById("mail-template");

      /* 手机（触摸为主）不弹邮件客户端：直接复制邮箱，避免很多机型 mailto 没配置 */
      const isTouch = window.matchMedia("(pointer: coarse)").matches || /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

      const labelEl = document.getElementById("cta-label");

      const flash = (el, text) => {
        const label = el.getAttribute("data-label");
        el.textContent = text;
        window.setTimeout(() => { if (label) el.textContent = label; }, 2000);
      };

      const flashLabel = () => {
        if (!labelEl) return;
        const label = labelEl.getAttribute("data-label") || "";
        labelEl.textContent = labelEl.getAttribute("data-copied") || "copied";
        window.setTimeout(() => { labelEl.textContent = label; }, 2000);
      };

      if (cta && isTouch) {
        cta.addEventListener("click", async (e) => {
          e.preventDefault();
          try {
            await navigator.clipboard.writeText(mail);
            flashLabel();
          } catch {
            /* 剪贴板 API 被拒（非 HTTPS / 隐私模式 / 旧内核）：
               退到 execCommand 复制；再不行就把邮箱显示出来让用户长按复制 */
            if (fallback) {
              fallback.classList.remove("hidden");
              try {
                const range = document.createRange();
                range.selectNodeContents(fallback);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
                if (document.execCommand("copy")) flashLabel();
              } catch (err) {
                /* 选中即可，用户手动复制 */
              }
            }
          }
        });
      }

      if (tplBtn && pre) {
        tplBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent || "");
            flash(tplBtn, tplBtn.getAttribute("data-copied") || "已复制");
          } catch {
            const range = document.createRange();
            range.selectNodeContents(pre);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
          }
        });
      }
    })();
  </script>
</BaseLayout>
