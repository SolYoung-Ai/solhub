---
import { siteConfig } from "@/data/site";
import { p } from "@/lib/paths";
import Logo from "./Logo.astro";
---

<footer class="border-t border-border bg-secondary/40">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href={p("/")} class="inline-block">
          <Logo />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-6 text-muted-foreground">
          {siteConfig.taglineZh}
        </p>
        <p class="mt-1 font-mono text-xs uppercase tracking-wider text-muted-foreground/70">
          {siteConfig.tagline}
        </p>
      </div>

      <nav aria-label="产品导航">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Explore</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={p("/")} class="text-foreground/80 transition-colors hover:text-accent">Discover</a></li>
          <li><a href={p("/launches/")} class="text-foreground/80 transition-colors hover:text-accent">Launches</a></li>
          <li><a href={p("/tools/")} class="text-foreground/80 transition-colors hover:text-accent">Tools</a></li>
        </ul>
      </nav>

      <nav aria-label="关于导航">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">About</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={p("/about/")} class="text-foreground/80 transition-colors hover:text-accent">关于 SolHub</a></li>
          <li><a href={p("/privacy/")} class="text-foreground/80 transition-colors hover:text-accent">隐私说明</a></li>
          <li><a href={p("/submit/")} class="text-foreground/80 transition-colors hover:text-accent">提交产品</a></li>
        </ul>
      </nav>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Project</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            siteConfig.githubUrl && (
              <li>
                <a
                  href={siteConfig.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-foreground/80 transition-colors hover:text-accent"
                >
                  GitHub 仓库 ↗
                </a>
              </li>
            )
          }
          <li>
            <a
              href={p("/about/#verification")}
              class="text-foreground/80 transition-colors hover:text-accent"
            >
              核验机制说明
            </a>
          </li>
          <li>
            <a
              href={p("/about/#roadmap")}
              class="text-foreground/80 transition-colors hover:text-accent"
            >
              路线图与限制
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {siteConfig.copyrightYear} SolHub · {siteConfig.tagline}</p>
      <p>由 SolYoung 构建 · 一个把想法变成作品的人</p>
    </div>
  </div>
</footer>
