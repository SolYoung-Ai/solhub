---
import { siteConfig } from "@/data/site";
import { p } from "@/lib/paths";
import { getDict, translate } from "@/i18n";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "zh" } = Astro.props;
const dict = getDict(locale);

/* 页脚全部功能入口：收在「关于」下拉里（桌面与手机共用同一份数据）。
 * 分组顺序沿用原来的四列：产品 / 关于 / 项目。 */
type MenuGroup = { title: string; links: { label: string; href: string; external?: boolean }[] };

const menuGroups: MenuGroup[] = [
  {
    title: locale === "en" ? "Product" : "产品",
    links: [
      { label: translate(dict, "footer.discover"), href: p("/", locale) },
      { label: translate(dict, "footer.launches"), href: p("/launches/", locale) },
    ],
  },
  {
    title: locale === "en" ? "About" : "关于",
    links: [
      { label: translate(dict, "nav.about"), href: p("/about/", locale) },
      { label: translate(dict, "footer.privacy"), href: p("/privacy/", locale) },
      { label: translate(dict, "nav.submit"), href: p("/submit/", locale) },
    ],
  },
  {
    title: locale === "en" ? "Project" : "项目",
    links: [
      ...(siteConfig.githubUrl
        ? [{ label: locale === "en" ? "GitHub repo ↗" : "GitHub 仓库 ↗", href: siteConfig.githubUrl, external: true }]
        : []),
      {
        label: locale === "en" ? "Verification" : "核验机制说明",
        href: p("/about/#verification", locale),
      },
    ],
  },
];
---

<footer class="border-t border-border bg-secondary/40">
  <div class="container-page flex items-center justify-between gap-3 py-3 md:py-4">
    <p class="min-w-0 flex-1 truncate text-[10px] text-muted-foreground/70 md:text-[11px]">
      <a href="https://solyoung.top/" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">
        {translate(dict, "footer.copyright", { year: siteConfig.copyrightYear })}
      </a>
    </p>

    <details class="group relative shrink-0">
      <summary
        class="flex cursor-pointer list-none items-center gap-1 rounded-full border border-border/80 px-2.5 py-1 text-[11px] text-muted-foreground transition-colors hover:border-border hover:text-foreground md:px-3 md:py-1.5 md:text-[12px] [&::-webkit-details-marker]:hidden"
      >
        {locale === "en" ? "About" : "关于"}
        <svg
          class="h-3 w-3 opacity-60 transition-transform duration-200 group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m18 15-6-6-6 6" />
        </svg>
      </summary>

      <div
        class="absolute bottom-full right-0 z-40 mb-2 w-56 overflow-hidden rounded-xl border border-border bg-background/95 p-1.5 shadow-lg backdrop-blur md:w-60"
      >
        {
          menuGroups.map((group) => (
            <div class="mt-1 first:mt-0">
              <p class="px-2 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-muted-foreground/60">
                {group.title}
              </p>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      class="block rounded-lg px-2 py-1.5 text-[12px] text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </div>
</footer>
