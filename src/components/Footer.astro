---
import { siteConfig } from "@/data/site";
import { p } from "@/lib/paths";
import { getDict, translate } from "@/i18n";
import type { Locale } from "@/i18n";
import Logo from "./Logo.astro";

interface Props {
  locale?: Locale;
}

const { locale = "zh" } = Astro.props;
const dict = getDict(locale);
---

<footer class="border-t border-border bg-secondary/40">
  <div class="container-page py-8">
    <div class="grid gap-6 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href={p("/", locale)} class="inline-block">
          <Logo locale={locale} size={22} textClass="text-[15px]" />
        </a>
        <p class="mt-3 max-w-xs text-[13px] leading-5 text-muted-foreground">
          {locale === "en" ? siteConfig.tagline : siteConfig.taglineZh}
        </p>
        <p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-muted-foreground/70">
          {siteConfig.tagline}
        </p>
      </div>

      <nav aria-label={locale === "en" ? "Product navigation" : "产品导航"}>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
          {translate(dict, "footer.products")}
        </p>
        <ul class="mt-2 space-y-1.5 text-[13px]">
          <li><a href={p("/", locale)} class="text-foreground/80 transition-colors hover:text-accent">{translate(dict, "footer.discover")}</a></li>
          <li><a href={p("/launches/", locale)} class="text-foreground/80 transition-colors hover:text-accent">{translate(dict, "footer.launches")}</a></li>
        </ul>
      </nav>

      <nav aria-label={locale === "en" ? "About" : "关于导航"}>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">About</p>
        <ul class="mt-2 space-y-1.5 text-[13px]">
          <li><a href={p("/about/", locale)} class="text-foreground/80 transition-colors hover:text-accent">{translate(dict, "nav.about")}</a></li>
          <li><a href={p("/privacy/", locale)} class="text-foreground/80 transition-colors hover:text-accent">{translate(dict, "footer.privacy")}</a></li>
          <li><a href={p("/submit/", locale)} class="text-foreground/80 transition-colors hover:text-accent">{translate(dict, "nav.submit")}</a></li>
        </ul>
      </nav>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Project</p>
        <ul class="mt-2 space-y-1.5 text-[13px]">
          {
            siteConfig.githubUrl && (
              <li>
                <a
                  href={siteConfig.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-foreground/80 transition-colors hover:text-accent"
                >
                  {locale === "en" ? "GitHub repo ↗" : "GitHub 仓库 ↗"}
                </a>
              </li>
            )
          }
          <li>
            <a
              href={p("/about/#verification", locale)}
              class="text-foreground/80 transition-colors hover:text-accent"
            >
              {locale === "en" ? "Verification" : "核验机制说明"}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-6 flex border-t border-border pt-4 text-[11px] text-muted-foreground">
      <p>
        <a href="https://solyoung.top/" target="_blank" rel="noopener noreferrer" class="text-foreground/80 transition-colors hover:text-accent">
          {translate(dict, "footer.copyright", { year: siteConfig.copyrightYear })}
        </a>
      </p>
    </div>
  </div>
</footer>
