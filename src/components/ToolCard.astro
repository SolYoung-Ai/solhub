---
import type { Tool } from "@/data/types";
import { categoryName } from "@/data/categories";
import { getIcon } from "@/lib/icons";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";
import { getDict, translate } from "@/i18n";
import { toolDescription } from "@/i18n/data";

interface Props {
  tool: Tool;
  locale?: Locale;
}

const { tool, locale = "zh" } = Astro.props;
const dict = getDict(locale);
const Icon = getIcon(tool.icon);
---

<a
  href={p(`/tools/${tool.slug}/`, locale)}
  class="card group flex h-full flex-col p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
>
  <div class="flex items-start justify-between gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-[8px] border border-border bg-secondary text-foreground/80 transition-colors group-hover:bg-accent group-hover:text-accent-foreground">
      <Icon className="h-5 w-5" aria-hidden="true" />
    </span>
    <span class="badge border-success/30 bg-success/10 text-success">{translate(dict, "common.free")}</span>
  </div>

  <h3 class="font-display mt-3 text-[15px] font-bold text-foreground group-hover:text-accent">
    {tool.name}
  </h3>
  <p class="mt-1 line-clamp-2 flex-1 text-[13px] leading-5 text-muted-foreground">
    {toolDescription(tool.slug, tool.description, locale)}
  </p>

  <div class="mt-4 flex items-center justify-between border-t border-border pt-3">
    <span class="text-[11px] text-muted-foreground">{categoryName(tool.category)}</span>
    <span class="inline-flex items-center gap-1 text-xs font-medium text-foreground/70 transition-all duration-150 group-hover:gap-2 group-hover:text-accent">
      {translate(dict, "tools.openTool")}
      <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
