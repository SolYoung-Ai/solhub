---
import type { VerificationStatus } from "@/data/types";
import { getIcon } from "@/lib/icons";
import { getDict, translate } from "@/i18n";
import type { Locale } from "@/i18n";

interface Props {
  status: VerificationStatus;
  isDemo?: boolean;
  locale?: Locale;
}

const { status, isDemo = false, locale = "zh" } = Astro.props;
const dict = getDict(locale);

const configs: Record<
  VerificationStatus,
  { label: string; icon: string; classes: string; titleKey: string }
> = {
  verified: {
    label: "Verified",
    icon: "ShieldCheck",
    classes: "border-success/30 bg-success/10 text-success",
    titleKey: "about.verifiedText",
  },
  pending: {
    label: "Pending",
    icon: "Clock",
    classes: "border-warning/30 bg-warning/10 text-warning",
    titleKey: "about.pendingText",
  },
  unverified: {
    label: "Unverified",
    icon: "ShieldAlert",
    classes: "border-border-strong bg-secondary/60 text-muted-foreground",
    titleKey: "about.unverifiedText",
  },
};

const cfg = configs[status];
const Icon = getIcon(cfg.icon);
---

<span class="inline-flex items-center gap-1.5">
  {
    isDemo && (
      <span
        class="badge border-border-strong bg-secondary text-muted-foreground"
        title={locale === "en" ? "Demo data: for display only, not real operation data" : "演示数据：仅用于展示产品形态，不代表真实运营数据"}
      >
        {translate(dict, "common.demo")} {locale === "en" ? "data" : "数据"}
      </span>
    )
  }
  <span class:list={["badge", cfg.classes]} title={translate(dict, cfg.titleKey)}>
    <Icon className="h-3 w-3" aria-hidden="true" />
    {cfg.label}
  </span>
</span>
