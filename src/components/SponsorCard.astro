---
/**
 * 赞助卡：三种形态对应三个档位
 * - strip：头图位，横向整宽
 * - card ：列表插入位，竖卡（与 ProductCard 同视觉）
 * - bar  ：社区伙伴，细单行
 *
 * url 为空说明这是示例卡（虚构品牌），按钮改为跳本页预订锚点，
 * 不制造点不开的假链接。
 */
import { p } from "@/lib/paths";
import type { Sponsor } from "@/data/sponsors";
import type { Locale } from "@/i18n";

interface Props {
  sponsor: Sponsor;
  variant: "strip" | "card" | "bar";
  locale?: Locale;
}

const { sponsor, variant, locale = "zh" } = Astro.props;
const en = locale === "en";
const label = en ? "Sponsored" : "赞助";
const cta = sponsor.url
  ? en
    ? "View product"
    : "查看产品"
  : en
    ? "Book this slot"
    : "预订这个位置";
const href = sponsor.url
  ? sponsor.url.startsWith("http")
    ? sponsor.url
    : p(sponsor.url, locale)
  : `#apply`;
const external = sponsor.url.startsWith("http");
const tagline = en ? sponsor.tagline.en : sponsor.tagline.zh;
const offer = sponsor.offer ? (en ? sponsor.offer.en : sponsor.offer.zh) : "";
const badge = sponsor.badge ? (en ? sponsor.badge.en : sponsor.badge.zh) : "";
---

{
  variant === "strip" && (
    <div class="card relative flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:gap-5 sm:p-5" data-sponsor={sponsor.id}>
      <div class="flex min-w-0 flex-1 items-center gap-3.5">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-[12px] text-[15px] font-bold text-white"
          style={`background-color:${sponsor.accent}`}
          aria-hidden="true"
        >
          {sponsor.icon ? <img src={p(sponsor.icon)} alt="" class="h-full w-full object-cover" /> : sponsor.initial}
        </span>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-display text-[15px] font-bold tracking-tight text-foreground">{sponsor.name}</span>
            {badge && (
              <span class="rounded-full border border-warning/35 bg-warning/10 px-2 py-0.5 text-[10px] font-semibold text-warning">
                {badge}
              </span>
            )}
          </div>
          <p class="mt-0.5 truncate text-[13px] text-muted-foreground">{tagline}</p>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-3 sm:gap-4">
        {offer && <span class="text-[12px] font-medium text-accent">{offer}</span>}
        <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="btn btn-outline !h-9 shrink-0 px-4 text-xs">
          {cta}
        </a>
      </div>
      <span class="absolute top-2 right-3 font-mono text-[9px] tracking-[0.16em] text-muted-foreground/60 uppercase">{label}</span>
    </div>
  )
}

{
  variant === "card" && (
    <div class="card relative flex h-full flex-col p-5" data-sponsor={sponsor.id}>
      {badge && (
        <span class="mb-3 inline-flex w-fit rounded-full border border-warning/35 bg-warning/10 px-2 py-0.5 text-[10px] font-semibold text-warning">
          {badge}
        </span>
      )}
      <div class="flex items-center gap-2.5">
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-[10px] text-[13px] font-bold text-white"
          style={`background-color:${sponsor.accent}`}
          aria-hidden="true"
        >
          {sponsor.icon ? <img src={p(sponsor.icon)} alt="" class="h-full w-full object-cover" /> : sponsor.initial}
        </span>
        <span class="font-display min-w-0 truncate text-[15px] font-bold tracking-tight text-foreground">{sponsor.name}</span>
      </div>
      <p class="mt-3 line-clamp-2 text-[13px] leading-6 text-muted-foreground">{tagline}</p>
      {offer && <p class="mt-1.5 text-[12px] font-medium text-accent">{offer}</p>}
      <div class="mt-auto pt-4">
        <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="btn btn-outline !h-9 w-full text-xs">
          {cta}
        </a>
      </div>
      <span class="font-mono absolute top-3 right-3 text-[9px] tracking-[0.16em] text-muted-foreground/60 uppercase">{label}</span>
    </div>
  )
}

{
  variant === "bar" && (
    <div class="flex items-center gap-3 rounded-full border border-border bg-card px-3 py-2" data-sponsor={sponsor.id}>
      <span class="font-mono shrink-0 text-[9px] tracking-[0.16em] text-muted-foreground/60 uppercase">{label}</span>
      <span class="h-3 w-px shrink-0 bg-border" aria-hidden="true" />
      <span
        class="flex h-5 w-5 shrink-0 items-center justify-center overflow-hidden rounded-[6px] text-[9px] font-bold text-white"
        style={`background-color:${sponsor.accent}`}
        aria-hidden="true"
      >
        {sponsor.icon ? <img src={p(sponsor.icon)} alt="" class="h-full w-full object-cover" /> : sponsor.initial}
      </span>
      <span class="min-w-0 flex-1 truncate text-[12px] text-foreground">
        <strong class="font-semibold">{sponsor.name}</strong>
        <span class="text-muted-foreground"> · {tagline}</span>
      </span>
      <a
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
        class="shrink-0 text-[11px] font-medium text-accent hover:underline"
      >
        {cta} ↗
      </a>
    </div>
  )
}
