---
import { siteConfig } from "@/data/site";
import { products } from "@/data/products";
import { tools } from "@/data/tools";
import { buildSearchIndex } from "@/lib/search";
import { p, stripBase, absoluteUrl } from "@/lib/paths";
import HeaderApp from "@/islands/HeaderApp.tsx";
import Footer from "@/components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** 当前路由（不含 base），用于 canonical 与导航激活 */
  route: string;
  ogType?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  route,
  ogType = "website",
  noIndex = false,
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const canonical = absoluteUrl(route);
const searchIndex = buildSearchIndex(products, tools);
const currentRoute = stripBase(Astro.url.pathname);

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: absoluteUrl("/"),
  description: siteConfig.description,
  inLanguage: "zh-CN",
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      noIndex && <meta name="robots" content="noindex" />
    }
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={p("/favicon.svg")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- 字体：与 SolYoung Studio 一致的 Archivo + Noto Sans SC -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href={p("/src/styles/global.css")} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <HeaderApp client:load currentRoute={currentRoute} searchIndex={searchIndex} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
