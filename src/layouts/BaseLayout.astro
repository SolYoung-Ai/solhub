---
import { siteConfig } from "@/data/site";
import { products } from "@/data/products";
import { skills } from "@/data/skills";
import { buildSearchIndex } from "@/lib/search";
import { p, stripBase, absoluteUrl, baseUrl } from "@/lib/paths";
import { getDict } from "@/i18n";
import type { Locale } from "@/i18n";
import HeaderApp from "@/islands/HeaderApp.tsx";
import Footer from "@/components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** 当前路由（不含 base、不含语言前缀），用于 canonical 与导航激活 */
  route: string;
  ogType?: string;
  noIndex?: boolean;
  /** 语言；zh 默认无前缀，en 生成到 /en/ 下 */
  locale?: Locale;
}

const {
  title,
  description,
  route,
  ogType = "website",
  noIndex = false,
  locale = "zh",
} = Astro.props;

const dict = getDict(locale);
const htmlLang = locale === "en" ? "en" : "zh-CN";
const ogLocale = locale === "en" ? "en_US" : "zh_CN";
const pageTitle =
  title === siteConfig.name || title.includes(siteConfig.name)
    ? title
    : `${title} · ${siteConfig.name}`;
const canonical = absoluteUrl(route, locale);
/* OG 图片必须是绝对地址（抓取方在站外解析），统一用根路径那一张 */
const ogImage = absoluteUrl("/og.png", "zh");
/* 全站导航搜索同时索引产品与 Skill 库；产品列表页自己只传 products */
const searchIndex = buildSearchIndex(products, locale, skills);
const currentRoute = stripBase(Astro.url.pathname);

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: absoluteUrl("/", locale),
  description: locale === "en" ? siteConfig.descriptionEn : siteConfig.description,
  inLanguage: locale === "en" ? "en" : "zh-CN",
};
---

<!doctype html>
<html lang={htmlLang} class="theme-init">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* 手机浏览器地址栏 / 状态栏配色：默认深色，随主题在下面的内联脚本里同步 */}
    <meta name="theme-color" content="#0a0908" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      noIndex && <meta name="robots" content="noindex" />
    }
    <link rel="canonical" href={canonical} />
    {/* 静态资源不加语言前缀：p() 带 locale 会生成 /en/favicon.png，
        而 public/ 下的文件只构建到根目录，英文页会 404（表现为英文站没有图标）。 */}
    <link rel="icon" type="image/png" href={p("/favicon.png")} />
    <link rel="apple-touch-icon" href={p("/apple-touch-icon.png")} />
    <meta name="solhub-base" content={baseUrl()} />

    <!-- 语言切换（alternate） -->
    <link rel="alternate" hreflang="zh-CN" href={absoluteUrl(route, "zh")} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(route, "en")} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(route, "zh")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <!-- 分享缩略图：微信 / X / Telegram / Slack 抓取的都是这两个字段。
         没有它，别人把作品或主页链接发到群里就只是一行裸文本。 -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 字体：与 SolYoung Studio 一致的 Archivo + Noto Sans SC -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600&display=swap"
      rel="stylesheet"
    />

    <!-- 首屏前恢复 主题 / 语言 / 视口 偏好（防止闪烁与错误语言停留） -->
    <script is:inline>
      (function () {
        try {
          // 0) GitHub 登录回传的令牌（移动端 iOS Safari 拦截跨站 Cookie，改用 URL 片段带回来）
          var hash = window.location.hash || "";
          var m = hash.match(/[#&]gh_token=([^&]+)/);
          if (m) {
            try {
              sessionStorage.setItem(
                "solhub:auth",
                JSON.stringify({ type: "github", token: decodeURIComponent(m[1]) }),
              );
            } catch (e) { /* 忽略存储不可用 */ }
            // 清掉片段，避免刷新/分享时泄露令牌
            var clean = window.location.pathname + window.location.search;
            if (window.history && window.history.replaceState) {
              window.history.replaceState(null, "", clean);
            }
          }

          // 1) 主题：dark class + 过渡
          //    深色是站点默认观感；只有用户手动切到浅色（存了 "light"）才走浅色。
          //    不跟随系统 prefers-color-scheme —— 否则同一台设备上深浅不一，品牌观感会飘。
          var savedTheme = localStorage.getItem("solhub:theme");
          var theme = savedTheme === "light" ? "light" : "dark";
          if (theme === "dark") document.documentElement.classList.add("dark");
          // 同步手机浏览器地址栏配色，否则深色页面顶上会挂一条白条
          var tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute("content", theme === "dark" ? "#0a0908" : "#ffffff");
          document.documentElement.classList.remove("theme-init");

          // 1.5) 侧栏收起状态：rail（图标栏）/ full（完整栏）
          //      状态挂在 <html data-nav> 上、由 CSS 决定宽度与文字显隐，
          //      必须在这儿（首帧前）恢复，否则每次跳页都会看到侧栏先展开再收起。
          var savedNav = localStorage.getItem("solhub:nav");
          if (savedNav === "rail" || savedNav === "full") {
            document.documentElement.setAttribute("data-nav", savedNav);
          }

          // 2) 视口模拟
          if (localStorage.getItem("solhub:viewport") === "mobile") {
            document.documentElement.classList.add("viewport-mobile");
          }

          // 3) 语言偏好：记住后自动跳转到对应语言版本（仅当路径不含目标语言前缀时）
          var savedLang = localStorage.getItem("solhub:lang");
          var base = (document.querySelector("meta[name='solhub-base']") || {}).getAttribute
            ? document.querySelector("meta[name='solhub-base']").getAttribute("content")
            : "";
          if (savedLang === "en" || savedLang === "zh") {
            var path = window.location.pathname;
            var hasEn = path.indexOf("/en/") !== -1 || path.endsWith("/en");
            var wantEn = savedLang === "en";
            if (wantEn !== hasEn) {
              // 构造目标路径
              if (wantEn) {
                // 当前 zh（无 /en/）→ 插入 /en/（跳过 base 前缀）
                var baseClean = base.replace(/\/$/, "");
                var rest = baseClean && path.indexOf(baseClean) === 0 ? path.slice(baseClean.length) : path;
                var target = baseClean + "/en" + (rest === "/" ? "/" : rest);
                window.location.replace(target);
              } else {
                // 当前 en → 去掉 /en/
                var t2 = path.replace(/\/en(\/|$)/, "/");
                window.location.replace(t2);
              }
            }
          }
        } catch (e) { /* 忽略存储不可用 */ }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body class="min-h-screen">
    {/* 桌面是「左侧栏 + 内容列」的并排结构，手机是单列（顶栏/底栏由 HeaderApp 渲染）。
        app-shell 必须在 lg 断点才变成 flex —— 手机上侧栏是 display:none，
        若整体一直是 flex，移动顶栏会成为第一个 flex item 而被挤成窄条。 */}
    <div class="app-shell">
      <HeaderApp client:load currentRoute={currentRoute} searchIndex={searchIndex} locale={locale} />
      <div class="app-content">
        <main class="flex-1">
          <slot />
        </main>
        {/* Footer 收进内容列：否则会横跨到侧栏下方，和内容列错位 */}
        <Footer locale={locale} />
      </div>
    </div>
  </body>
</html>

