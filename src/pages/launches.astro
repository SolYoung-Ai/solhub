---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { products } from "@/data/products";
import { rankingRules } from "@/lib/ranking";
import LaunchesExplorer from "@/islands/LaunchesExplorer.tsx";
---

<BaseLayout
  title="产品发布榜单"
  description="SolHub 产品发布榜单：浏览独立开发者正在创造的产品，按分类筛选、按最新收录排序，核验状态透明可解释。"
  route="/launches/"
>
  <section class="border-b border-border bg-secondary/30 py-14">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
        Launches
      </p>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        产品发布榜单
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">
        发现独立开发者正在创造的产品。所有排名都有清晰的规则，核验状态以 SolHub
        实际核验为准；演示数据带有明确标记，不会伪装成真实运营数据。
      </p>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          rankingRules.map((rule) => (
            <div class="card p-4">
              <p class="text-[13px] font-semibold text-foreground">{rule.title}</p>
              <p class="mt-1 text-xs leading-5 text-muted-foreground">{rule.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="container-page">
      <LaunchesExplorer client:load products={products} />
    </div>
  </section>
</BaseLayout>
