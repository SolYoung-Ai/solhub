---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { products } from "@/data/products";
import LaunchesExplorer from "@/islands/LaunchesExplorer.tsx";
import AdRail from "@/islands/AdRail.tsx";
import AdSlot from "@/components/AdSlot.astro";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? "SolHub products: browse what indie developers are building, filter by category, sort by newest, with transparent verification status."
  : "SolHub 产品列表：浏览独立开发者正在创造的产品，按分类筛选、按最新收录排序，核验状态透明可解释。";
---

<BaseLayout
  title={en ? "Products" : "产品"}
  description={metaDesc}
  route="/launches/"
  locale={locale}
>
  <section class="border-b border-border bg-secondary/30 py-6 sm:py-8">
    <div class="container-page">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-xl font-extrabold tracking-tight text-foreground sm:text-2xl">
          {en ? "Products" : "产品"}
        </h1>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Verified first" : "核验优先"}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Global picks" : "全球精选"}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Ranked by clicks" : "按点击量排名"}
        </span>
      </div>
    </div>
  </section>

  <section class="py-8 sm:py-12">
    <div class="container-page">
      <div class="lg:flex lg:items-stretch lg:gap-6">
        <div class="min-w-0 flex-1">
          <LaunchesExplorer client:load products={products} locale={locale} />
        </div>
        <AdRail client:idle locale={locale} />
      </div>
    </div>
  </section>

  <!-- 广告位：列表读完再出，不打断浏览 -->
  <section class="container-page pb-10">
    <AdSlot unit="list" locale={locale} />
  </section>
</BaseLayout>
