---
/**
 * 热点（/hot/）—— AI、产品、科技、金融的全网最新动态
 *
 * 内容不是站内生产的，是聚合 10 家中文科技媒体的公开 RSS：只取标题 + 链接 +
 * 一句导语，每条都跳回原站。这是「导流式聚合」，不是转载 —— 页面上不出现任何
 * 正文段落，也没有镜像图。
 *
 * 为什么只做中文源：读者是中文的。英文源（TechCrunch / HN）要变成可读中文就得
 * 逐条机翻，成本与失败率都不划算；而这批媒体本身就在做小时级的编译，用它们的
 * 稿子质量更高。想看一手英文原文的话，产品页里那几个资讯入口更合适。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import HotFeed from "@/islands/HotFeed.tsx";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? "A running feed of what's happening in AI, products, tech and finance — aggregated from 10 Chinese tech media RSS sources, refreshed every 15 minutes, each headline linked to the original."
  : "AI、产品、科技、金融的最新动态：聚合 10 家中文科技媒体的公开 RSS，每 15 分钟更新一次，每条都跳回原文。";
---

<BaseLayout title={en ? "Hot" : "热点"} description={metaDesc} route="/hot/" locale={locale}>
  <section class="border-b border-border bg-secondary/30 py-6 sm:py-8">
    <div class="container-page">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-xl font-extrabold tracking-tight text-foreground sm:text-2xl">
          {en ? "Hot right now" : "热点"}
        </h1>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Auto-refreshed" : "自动更新"}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Links to originals" : "跳转原文"}
        </span>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a href={p("/launches/", locale)} class="btn btn-outline !h-9 px-4 text-xs">
          {en ? "Browse products" : "看看产品"}
        </a>
        <a href={p("/skills/", locale)} class="btn btn-outline !h-9 px-4 text-xs">
          {en ? "Skill library" : "Skill 库"}
        </a>
      </div>
    </div>
  </section>

  <section class="py-6 sm:py-8">
    <div class="container-page">
      <HotFeed client:load locale={locale} />
    </div>
  </section>
</BaseLayout>
