---
/**
 * 热点（/hot/）—— AI、产品、科技、金融的全网最新动态
 *
 * 内容不是站内生产的，是聚合 34 家媒体（中文 15 + 全球 19）的公开 RSS：
 * 只取标题 + 链接 + 一句导语，每条都跳回原站。这是「导流式聚合」，不是转载 ——
 * 页面上不出现任何正文段落，也没有镜像图。
 *
 * 为什么读者看到的全是中文：中文源本就中文供稿；全球源（TechCrunch / The Verge /
 * WIRED / WSJ…）的标题与摘要在云函数里翻成中文再入库，翻译见 worker/translate.js。
 * 翻不出来的条目留在库里等下一轮重试，不会以英文乱入一个中文列表。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import HotFeed from "@/islands/HotFeed.tsx";
import MarketTicker from "@/islands/MarketTicker.tsx";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? "A running feed of what's happening in AI, products, tech and finance — aggregated from 34 media outlets worldwide, refreshed every 15 minutes, every headline in Chinese and linked to the original."
  : "AI、产品、科技、金融的最新动态：聚合 34 家媒体（中文 15 家 + 全球 19 家）的公开 RSS，每 15 分钟更新一次，标题统一中文，每条都跳回原文。";
---

<BaseLayout title={en ? "Hot" : "热点"} description={metaDesc} route="/hot/" locale={locale}>
  <section class="border-b border-border bg-secondary/30 py-6 sm:py-8">
    <div class="container-page">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-xl font-extrabold tracking-tight text-foreground sm:text-2xl">
          {en ? "Hot right now" : "热点"}
        </h1>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Auto-refreshed" : "自动更新"}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Links to originals" : "跳转原文"}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "34 outlets" : "34 家媒体"}
        </span>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a href={p("/launches/", locale)} class="btn btn-outline !h-9 px-4 text-xs">
          {en ? "Browse products" : "看看产品"}
        </a>
        <a href={p("/skills/", locale)} class="btn btn-outline !h-9 px-4 text-xs">
          {en ? "Skill library" : "Skill 库"}
        </a>
      </div>
    </div>
  </section>

  <section class="py-6 sm:py-8">
    <div class="container-page">
      <MarketTicker client:load locale={locale} />
      <HotFeed client:load locale={locale} />
    </div>
  </section>
</BaseLayout>
