---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminConsole from "@/islands/AdminConsole.tsx";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "zh";
---

<BaseLayout
  title={locale === "en" ? "Admin · SolHub" : "管理后台 · SolHub"}
  description="SolHub 管理后台"
  route="/guanli/"
  locale={locale}
  noIndex={true}
>
  <div class="container-page py-8">
    <AdminConsole client:load locale={locale} />
  </div>
</BaseLayout>
