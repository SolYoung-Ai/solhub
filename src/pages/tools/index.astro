---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { tools } from "@/data/tools";
import ToolsExplorer from "@/islands/ToolsExplorer.tsx";
import CommunityFeed from "@/islands/CommunityFeed.tsx";

const initialCategory = Astro.url.searchParams.get("category") ?? "all";
---

<BaseLayout
  title="免费在线工具"
  description="SolHub 免费在线工具箱：JSON 格式化、文本统计、Base64、UUID、二维码、图片压缩等实用工具，全部在浏览器本地运行，无需注册。"
  route="/tools/"
>
  <section class="border-b border-border bg-secondary/30 py-14">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
        Tools
      </p>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        免费在线工具箱
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">
        简单、实用、免费。所有工具都直接可用，无需登录；你的输入只在浏览器本地处理，
        不会上传到任何服务器。
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-page">
      <ToolsExplorer client:load tools={tools} initialCategory={initialCategory} />
      <CommunityFeed client:load kind="tool" limit={8} title="社区工具" />
    </div>
  </section>
</BaseLayout>
