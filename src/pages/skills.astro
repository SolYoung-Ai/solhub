---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkillsExplorer from "@/islands/SkillsExplorer.tsx";
import { skills, SKILLS_SNAPSHOT } from "@/data/skills";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? "A curated directory of the most popular Agent Skills: find-skills, superpowers, Anthropic's official skills, design and engineering skill packs — with install commands, GitHub stars and skills.sh install counts."
  : "精选当下最火的 Agent Skills：find-skills、superpowers、Anthropic 官方技能、设计与工程技能合集，附安装命令、GitHub Stars 与 skills.sh 安装量。";
---

<BaseLayout
  title={en ? "Skills" : "Skill"}
  description={metaDesc}
  route="/skills/"
  locale={locale}
>
  <section class="border-b border-border bg-secondary/30 py-6 sm:py-8">
    <div class="container-page">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-xl font-extrabold tracking-tight text-foreground sm:text-2xl">
          {en ? "Popular Agent Skills" : "热门 Skill 库"}
        </h1>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `${skills.length} curated` : `${skills.length} 条精选`}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Install commands included" : "附安装命令"}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `Snapshot ${SKILLS_SNAPSHOT}` : `快照 ${SKILLS_SNAPSHOT}`}
        </span>
      </div>
      <p class="mt-3 max-w-3xl text-[13px] leading-6 text-muted-foreground sm:text-[14px]">
        {en
          ? "Skills are reusable folders of instructions, scripts and resources that teach an AI agent how to do a specific job. We hand-picked the most-installed skills from skills.sh and the most-starred skill collections on GitHub — all in one place, with the command to install each one."
          : "Skill 是一组可复用的指令、脚本与资源，教会 AI Agent 把某件具体的事按固定流程做好。这里汇总了 skills.sh 安装量最高、以及 GitHub 上 Star 最多的 Skill 与技能合集，附上一条命令就能安装。"}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a href={p("/submit/?type=skill", locale)} class="btn btn-accent !h-9 px-4 text-xs">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          {en ? "Submit a Skill" : "提交 Skill"}
        </a>
        <a
          href="https://skills.sh/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline !h-9 px-4 text-xs"
        >
          skills.sh ↗
        </a>
        <a
          href="https://github.com/topics/agent-skills"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline !h-9 px-4 text-xs"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </section>

  <section class="py-7 sm:py-10">
    <div class="container-page">
      <SkillsExplorer client:load skills={skills} locale={locale} />
    </div>
  </section>
</BaseLayout>
