---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkillsExplorer from "@/islands/SkillsExplorer.tsx";
import AdSlot from "@/components/AdSlot.astro";
import SkillGuide from "@/islands/SkillGuide.tsx";
import { skills, SKILLS_SNAPSHOT } from "@/data/skills";
import { SKILL_SOURCES, SKILL_SOURCE_GROUPS } from "@/data/skills-sources";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? `${skills.length} hand-picked Agent Skills with one-line install commands and source links, plus the official sources, aggregators and community directories to verify and discover more.`
  : `${skills.length} 条人工精选的 Agent Skill，附一行安装命令与出处；页面底部汇总官方源头、聚合站与社区目录，方便自行核验与继续发现。`;
---

<BaseLayout
  title={en ? "Skills" : "Skill"}
  description={metaDesc}
  route="/skills/"
  locale={locale}
>
  <section class="border-b border-border bg-secondary/30 py-6 sm:py-8">
    <div class="container-page">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-xl font-extrabold tracking-tight text-foreground sm:text-2xl">
          {en ? "Popular Agent Skills" : "热门 Skill 库"}
        </h1>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `${skills.length} curated` : `${skills.length} 条精选`}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `Snapshot ${SKILLS_SNAPSHOT}` : `快照 ${SKILLS_SNAPSHOT}`}
        </span>
        {/* 使用教程小标签：点击弹出快速上手弹窗，也支持 /skills/?guide=1 直达 */}
        <SkillGuide client:load locale={locale} />
      </div>
      <p class="mt-3 max-w-3xl text-[13px] leading-6 text-muted-foreground sm:text-[14px]">
        {en
          ? "Skills are reusable folders of instructions, scripts and resources that teach an AI agent how to do a specific job well. Below are the most-installed skills, each with a one-line install command and a link to its source. The bottom of the page lists the official sources, aggregators and community directories so you can verify and keep exploring on your own."
          : "Skill 是一组可复用的指令、脚本与资源，教会 AI Agent 把某件具体的事按固定流程做好。下面按安装量与实用性精选了这些条目，每条都附一键安装命令和出处；页面底部汇总了官方源头与社区目录，想找更多可以顺着这些入口自己挖。"}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a href={p("/submit/?type=skill", locale)} class="btn btn-accent !h-9 px-4 text-xs">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          {en ? "Submit a Skill" : "提交 Skill"}
        </a>
        <a href="https://skills.sh/" target="_blank" rel="noopener noreferrer" class="btn btn-outline !h-9 px-4 text-xs">skills.sh ↗</a>
        <a href="https://findskills.org" target="_blank" rel="noopener noreferrer" class="btn btn-outline !h-9 px-4 text-xs">FindSkills ↗</a>
        <a href="https://agentskills.io" target="_blank" rel="noopener noreferrer" class="btn btn-outline !h-9 px-4 text-xs">agentskills.io ↗</a>
        <a href="#sources" class="btn btn-outline !h-9 px-4 text-xs">
          {en ? "Data sources ↓" : "数据来源 ↓"}
        </a>
      </div>
    </div>
  </section>

  <section class="py-7 sm:py-10">
    <div class="container-page">
      <SkillsExplorer client:load skills={skills} locale={locale} />
    </div>
  </section>

  <!-- 广告位：精选区与来源清单之间的天然断点 -->
  <section class="container-page py-2">
    <AdSlot unit="list" locale={locale} />
  </section>

  <section id="sources" class="scroll-mt-20 border-t border-border bg-secondary/20 py-8 sm:py-10">
    <div class="container-page">
      <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">
        {en ? "Sources & verification" : "数据来源与核验"}
      </h2>
      <p class="mt-2 max-w-3xl text-[13px] leading-6 text-muted-foreground">
        {en
          ? "Every link below was checked by hand. Skill collections change fast — treat these as entry points and verify the exact version yourself before installing anything."
          : "下面每一条都是逐个点开确认过的入口。Skill 生态变化很快，这些只当入口用；真正安装前请自己确认对应版本。"}
      </p>

      <div class="mt-6 grid min-w-0 gap-4 sm:grid-cols-3">
        {SKILL_SOURCE_GROUPS.map((g) => (
          <div class="card min-w-0 p-4">
            <h3 class="text-[13px] font-bold text-foreground">{en ? g.en : g.zh}</h3>
            <ul class="mt-3 space-y-3">
              {SKILL_SOURCES.filter((r) => r.group === g.key).map((r) => (
                <li class="min-w-0">
                  <a
                    href={r.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex max-w-full items-start gap-1 break-words text-[12px] font-medium text-accent hover:underline"
                  >
                    <span class="min-w-0 break-words">{en ? r.nameEn : r.name}</span>
                    <span aria-hidden="true" class="shrink-0">↗</span>
                  </a>
                  <p class="mt-0.5 text-[11px] leading-4 text-muted-foreground">{en ? r.noteEn : r.note}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-5 rounded-[16px] border border-border bg-secondary/30 p-4">
        <h3 class="text-[13px] font-bold text-foreground">
          {en ? "How to tell a real Skill from a label" : "怎么判断一条是不是真 Skill"}
        </h3>
        <p class="mt-1.5 text-[12px] leading-5 text-muted-foreground">
          {en
            ? "FindSkills reports 117,914 indexed entries (clawhub 88,367 / github 24,880 / smithery 4,662 as of 2026-11-08), but its scope is broad and counts ordinary repositories such as VS Code and NumPy as skills. The reliable test is simple: a real Skill lives in a directory that contains a SKILL.md file whose YAML frontmatter names it and describes what it does. No source file, no Skill — that is also the rule used for the curated list above."
            : "FindSkills 标注索引 117,914 条（2026-11-08：clawhub 88,367 / github 24,880 / smithery 4,662），口径较宽，会把 VS Code、NumPy 等普通仓库也计为 skill。判断方法其实很简单：真 Skill 一定在一个包含 SKILL.md 的目录里，文件开头的 YAML frontmatter 写着它的名字和用途。没有源文件就不算——上面精选区也按这条标准收录。"}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
