---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkillsExplorer from "@/islands/SkillsExplorer.tsx";
import AdSlot from "@/components/AdSlot.astro";
import SkillsCatalog from "@/islands/SkillsCatalog.tsx";
import SkillGuide from "@/islands/SkillGuide.tsx";
import { skills, SKILLS_SNAPSHOT } from "@/data/skills";
import catalogMeta from "../data/skills-catalog-meta.json";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";
const totalCount = skills.length + catalogMeta.total;

const metaDesc = en
  ? `${totalCount} Agent Skills: ${skills.length} hand-picked with install commands, plus ${catalogMeta.total} real SKILL.md files indexed from public GitHub repositories. Verifiable sources, official Anthropic / OpenAI skills, and the open Agent Skills standard.`
  : `${totalCount} 条 Agent Skill 收录：${skills.length} 条人工精选（附安装命令），另有 ${catalogMeta.total} 条来自公开 GitHub 仓库的真实 SKILL.md 索引，来源可核验。`;

const sourceGroups = [
  { key: "official", zh: "官方与标准源头", en: "Official & standards" },
  { key: "aggregator", zh: "聚合搜索站 / 市场", en: "Aggregators & marketplaces" },
  { key: "directory", zh: "社区目录仓库", en: "Community lists" },
];

const collectedSources = catalogMeta.sources.filter((s) => s.included > 0);
---

<BaseLayout
  title={en ? "Skills" : "Skill"}
  description={metaDesc}
  route="/skills/"
  locale={locale}
>
  <section class="border-b border-border bg-secondary/30 py-6 sm:py-8">
    <div class="container-page">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-xl font-extrabold tracking-tight text-foreground sm:text-2xl">
          {en ? "Popular Agent Skills" : "热门 Skill 库"}
        </h1>
        <span class="rounded-full border border-accent/25 bg-accent/5 px-2.5 py-0.5 text-[11px] font-semibold text-accent">
          {en ? `${totalCount.toLocaleString()} listed` : `共 ${totalCount.toLocaleString()} 条`}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `${skills.length} curated` : `${skills.length} 条精选`}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `${catalogMeta.total.toLocaleString()} SKILL.md indexed` : `${catalogMeta.total.toLocaleString()} 条 SKILL.md 索引`}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `Snapshot ${SKILLS_SNAPSHOT}` : `快照 ${SKILLS_SNAPSHOT}`}
        </span>
        {/* 使用教程小标签：点击弹出快速上手弹窗，也支持 /skills/?guide=1 直达 */}
        <SkillGuide client:load locale={locale} />
      </div>
      <p class="mt-3 max-w-3xl text-[13px] leading-6 text-muted-foreground sm:text-[14px]">
        {en
          ? "Skills are reusable folders of instructions, scripts and resources that teach an AI agent how to do a specific job. The curated section lists the most-installed skills from skills.sh with one-line install commands. Below it, a machine-collected index of 1,000 real SKILL.md files from public GitHub repositories — every entry links to its source file so you can verify it yourself."
          : "Skill 是一组可复用的指令、脚本与资源，教会 AI Agent 把某件具体的事按固定流程做好。上半部分是 skills.sh 安装量最高的精选条目，附一键安装命令；下半部分是全网采集的 1000 个真实 SKILL.md 文件索引，每条都可点开源文件核验。"}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a href={p("/submit/?type=skill", locale)} class="btn btn-accent !h-9 px-4 text-xs">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          {en ? "Submit a Skill" : "提交 Skill"}
        </a>
        <a href="https://skills.sh/" target="_blank" rel="noopener noreferrer" class="btn btn-outline !h-9 px-4 text-xs">skills.sh ↗</a>
        <a href="https://findskills.org" target="_blank" rel="noopener noreferrer" class="btn btn-outline !h-9 px-4 text-xs">FindSkills ↗</a>
        <a href="https://agentskills.io" target="_blank" rel="noopener noreferrer" class="btn btn-outline !h-9 px-4 text-xs">agentskills.io ↗</a>
        <a href="#sources" class="btn btn-outline !h-9 px-4 text-xs">
          {en ? "Data sources ↓" : "数据来源 ↓"}
        </a>
      </div>
    </div>
  </section>

  <section class="py-7 sm:py-10">
    <div class="container-page">
      <SkillsExplorer client:load skills={skills} locale={locale} />
    </div>
  </section>

  <!-- 广告位：精选区与全量索引之间的天然断点 -->
  <section class="container-page py-2">
    <AdSlot unit="list" locale={locale} />
  </section>

  <section id="catalog" class="scroll-mt-20 border-t border-border bg-secondary/20 py-8 sm:py-10">
    <div class="container-page">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">
          {en ? "Full Skill index" : "全网 Skill 索引"}
        </h2>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? `${catalogMeta.total.toLocaleString()} real SKILL.md` : `${catalogMeta.total.toLocaleString()} 个真实 SKILL.md`}
        </span>
        <span class="rounded-full border border-border bg-card px-2.5 py-0.5 text-[11px] text-muted-foreground">
          {en ? "Source-verifiable" : "来源可核验"}
        </span>
      </div>
      <p class="mt-2 max-w-3xl text-[13px] leading-6 text-muted-foreground">
        {en
          ? `Collected from ${collectedSources.length} public GitHub repositories (${catalogMeta.totalCandidates.toLocaleString()} SKILL.md files discovered). Names and descriptions come straight from each SKILL.md frontmatter. Browse by source repository, category or keyword.`
          : `从 ${collectedSources.length} 个公开 GitHub 仓库采集（全网共发现 ${catalogMeta.totalCandidates.toLocaleString()} 个 SKILL.md 文件）。名称与简介直接取自每个文件的 frontmatter，可按来源仓库、分类或关键词检索。`}
      </p>
      <div class="mt-5">
        <SkillsCatalog client:load locale={locale} />
      </div>
    </div>
  </section>

  <section id="sources" class="scroll-mt-20 border-t border-border py-8 sm:py-10">
    <div class="container-page">
      <h2 class="font-display text-lg font-extrabold tracking-tight text-foreground sm:text-xl">
        {en ? "Sources & verification" : "数据来源与核验"}
      </h2>
      <p class="mt-2 max-w-3xl text-[13px] leading-6 text-muted-foreground">
        {en ? catalogMeta.method : catalogMeta.methodZh}
      </p>

      <div class="mt-6 grid min-w-0 gap-4 sm:grid-cols-3">
        {sourceGroups.map((g) => (
          <div class="card min-w-0 p-4">
            <h3 class="text-[13px] font-bold text-foreground">{en ? g.en : g.zh}</h3>
            <ul class="mt-3 space-y-3">
              {catalogMeta.references.filter((r) => r.group === g.key).map((r) => (
                <li class="min-w-0">
                  <a
                    href={r.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex max-w-full items-start gap-1 break-words text-[12px] font-medium text-accent hover:underline"
                  >
                    <span class="min-w-0 break-words">{en ? r.nameEn : r.name}</span>
                    <span aria-hidden="true" class="shrink-0">↗</span>
                  </a>
                  <p class="mt-0.5 text-[11px] leading-4 text-muted-foreground">{en ? r.noteEn : r.note}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-5 rounded-[16px] border border-border bg-secondary/30 p-4">
        <h3 class="text-[13px] font-bold text-foreground">
          {en ? "About the aggregator's coverage" : "关于聚合站的收录口径"}
        </h3>
        <p class="mt-1.5 text-[12px] leading-5 text-muted-foreground">
          {en
            ? "FindSkills reports 117,914 indexed entries (clawhub 88,367 / github 24,880 / smithery 4,662 as of 2026-11-08), but its index is broad and includes ordinary GitHub repositories such as VS Code and NumPy. SolHub therefore only lists entries that have a real SKILL.md file, and links to that file for verification. Categories are auto-assigned by keyword and are not an editorial endorsement."
            : "FindSkills 标注索引 117,914 条（2026-11-08：clawhub 88,367 / github 24,880 / smithery 4,662），但其口径较宽，会把 VS Code、NumPy 等普通仓库也计为 skill。SolHub 只收录确实存在 SKILL.md 文件的条目，并附上源文件链接供核验；分类为关键词自动归类，不代表人工背书。"}
        </p>
      </div>

      <p class="mt-4 text-[11px] leading-5 text-muted-foreground">
        {en
          ? `Indexed repositories: ${collectedSources.map((s) => `${s.repo} (${s.included})`).join(" · ")}.`
          : `实际采集仓库：${collectedSources.map((s) => `${s.repo}（${s.included} 条）`).join(" · ")}。`}
      </p>
    </div>
  </section>
</BaseLayout>
