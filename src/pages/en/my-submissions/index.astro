---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MySubmissions from "@/islands/MySubmissions.tsx";
import type { Locale } from "@/i18n";

const locale: Locale = "en";
---

<BaseLayout
  title={locale === "en" ? "My submissions · SolHub" : "我的提交 · SolHub"}
  description={locale === "en" ? "Manage your product and Skill submissions on SolHub." : "管理你提交到 SolHub 的产品与 Skill。"}
  route="/my-submissions/"
  locale={locale}
>
  <div class="container-page py-10">
    <MySubmissions client:load locale={locale} />
  </div>
</BaseLayout>
