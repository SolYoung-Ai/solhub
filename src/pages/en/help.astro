---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { p } from "@/lib/paths";
import { Mail, MessageCircleQuestion, ArrowUpRight } from "lucide-react";
import type { Locale } from "@/i18n";

const locale: Locale = "en";
const EMAIL = "solyoungwork@qq.com";

const faqs = [
  { q: "How do I submit a product?", a: "Sign in, open Submit, add the site URL and a one-line description. If the link opens, it goes live automatically — no review queue.", href: p("/submit/", locale), linkText: "Submit" },
  { q: "When does the verified badge appear?", a: "After you verify your email and submit at least one product. Both are required — verifying alone does not light up the badge.", href: p("/account/", locale), linkText: "Account" },
  { q: "How do points work?", a: "Invite a creator and you both get 100 points; you can also redeem codes. Points pay for the sponsored slot in the side rail.", href: p("/wallet/", locale), linkText: "Wallet" },
  { q: "A redeem code doesn't work", a: "Check the format first (SHUB-XXXX-XXXX). If it says already used, that code has been redeemed — each code works once. If a brand-new code fails, email me the code and I'll check the record.", href: p("/wallet/", locale), linkText: "Redeem" },
  { q: "My listing is wrong / I want it removed", a: "You can edit or delete your own products from My account. If someone else listed your site, email me the domain and I'll fix or remove it.", href: p("/my-submissions/", locale), linkText: "My account" },
  { q: "How do I book a sponsored slot?", a: "Use “Get this slot” under the rail card on Products, Hot or Creators. 300 points per week, paid from your wallet; only products on your own account can be featured.", href: p("/ads/", locale), linkText: "Ad slots" },
];
---

<BaseLayout
  title="Help & feedback · SolHub"
  description="Answers to common questions about submitting products, verification, points and sponsored slots — plus how to reach us."
  route="/help/"
  locale={locale}
>
  <div class="container-page max-w-3xl py-10 sm:py-14">
    <header>
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">Help</p>
      <h1 class="mt-1.5 font-display text-2xl font-extrabold tracking-tight text-foreground sm:text-[30px]">Help & feedback</h1>
      <p class="mt-2 text-[13.5px] leading-7 text-muted-foreground">
        Stuck on something, or found a bug? Email is the fastest way to reach me — I read every message.
      </p>
    </header>

    <section class="mt-6 overflow-hidden rounded-[18px] border border-border bg-card">
      <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[11px] bg-accent/10 text-accent">
            <Mail className="h-4 w-4" aria-hidden="true" />
          </span>
          <div class="min-w-0">
            <p class="text-[13.5px] font-semibold text-foreground">Email</p>
            <a href={`mailto:${EMAIL}?subject=${encodeURIComponent("SolHub feedback")}`} class="mt-0.5 block break-all font-mono text-[13px] text-accent hover:underline">
              {EMAIL}
            </a>
          </div>
        </div>
        <a href={`mailto:${EMAIL}?subject=${encodeURIComponent("SolHub feedback")}`} class="btn btn-accent !h-9 shrink-0 gap-1.5 px-4 text-xs">
          Send email <ArrowUpRight className="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      </div>
      <p class="border-t border-border px-5 py-3 text-[11.5px] leading-5 text-muted-foreground">
        Helpful details: the page URL, what you expected, what happened, and your browser. Screenshots welcome.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="flex items-center gap-2 font-display text-[17px] font-bold text-foreground">
        <MessageCircleQuestion className="h-4 w-4 text-accent" aria-hidden="true" />
        Common questions
      </h2>
      <div class="mt-3 divide-y divide-border overflow-hidden rounded-[18px] border border-border bg-card">
        {faqs.map((f) => (
          <details class="group px-5 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-[13.5px] font-semibold text-foreground [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="text-muted-foreground transition-transform duration-200 group-open:rotate-45">＋</span>
            </summary>
            <p class="mt-2 text-[12.5px] leading-6 text-muted-foreground">{f.a}</p>
            <a href={f.href} class="mt-2 inline-flex items-center gap-0.5 text-[12px] text-accent hover:underline">
              {f.linkText} <ArrowUpRight className="h-3 w-3" aria-hidden="true" />
            </a>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-6 text-center text-[11.5px] leading-5 text-muted-foreground">
      SolHub is run by one person — replies may take a day or two, but nothing gets ignored.
    </p>
  </div>
</BaseLayout>
