---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JoinSignup from "@/islands/JoinSignup.tsx";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const points = [
  { title: en ? "Editor-curated catalog" : "编辑收录，不靠刷量", desc: en ? "Listed once the link opens — no queue, no paid placement." : "链接能打开就收录，不排队、不买榜。" },
  { title: en ? "Real verification" : "真实核验", desc: en ? "A green badge means the link was actually checked." : "绿标代表链接被真实打开过，不是自动盖章。" },
  { title: en ? "Ranked by clicks" : "按点击量排名", desc: en ? "Verified first, then real clicks — rules are public." : "核验优先、再看真实点击，规则公开。" },
];
---

<BaseLayout
  title={en ? "Join SolHub · get 100 points" : "加入 SolHub · 领取 100 积分"}
  description={
    en
      ? "Create a SolHub account and get 100 points — the inviter gets 100 too. Points buy a rail slot for your product."
      : "注册 SolHub 即得 100 积分，邀请你的人同样得 100。积分可以买右栏广告位。"
  }
  route="/join/"
  locale={locale}
>
  <section class="py-10 sm:py-16">
    <div class="container-page">
      <div class="mx-auto grid max-w-4xl items-start gap-8 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-12">
        <!-- 左：一句话说清 -->
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
            {en ? "Creator program" : "全球创作者计划"}
          </p>
          <h1 class="mt-2 font-display text-[30px] font-extrabold leading-[1.15] tracking-tight text-foreground sm:text-[38px]">
            {en ? "Join SolHub," : "加入 SolHub，"}
            <span class="mt-1 block text-accent">{en ? "get 100 points" : "立即领 100 积分"}</span>
          </h1>
          <p class="mt-3 max-w-md text-[14px] leading-7 text-muted-foreground">
            {en
              ? "One email, no card. Points land in your wallet the moment the account exists, and the person who invited you gets 100 too."
              : "一个邮箱就能加入，不用信用卡。账号建好积分立刻进钱包，邀请你的人也同样拿到 100。"}
          </p>

          <ul class="mt-6 space-y-2.5">
            {points.map((it) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70" aria-hidden="true" />
                <p class="text-[13px] leading-6 text-foreground/85">
                  <strong class="font-semibold text-foreground">{it.title}</strong>
                  <span class="text-muted-foreground"> · {it.desc}</span>
                </p>
              </li>
            ))}
          </ul>

          <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-[12.5px]">
            <a href={p("/wallet/", locale)} class="text-accent hover:underline">
              {en ? "What is the wallet? →" : "积分能干什么？→"}
            </a>
            <a href={p("/launches/", locale)} class="text-muted-foreground hover:text-foreground">
              {en ? "Browse products" : "先看看产品"}
            </a>
          </div>
        </div>

        <!-- 右：注册卡 -->
        <div id="signup">
          <JoinSignup client:load locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
