---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/data/site";
import { p } from "@/lib/paths";
import RecruitShare from "@/islands/RecruitShare.tsx";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? "SolHub is recruiting indie creators worldwide — developers, designers and tool-makers. A transparent, honest stage with real verification and no fake metrics. Submit your product and get discovered."
  : "SolHub 正在全球招募独立创作者——开发者、设计师与工具作者。一个透明、真实、没有虚假流量的舞台，让你的作品被世界看见。提交产品，即刻公开。";
---

<BaseLayout
  title={en ? "Recruiting Creators Worldwide · SolHub" : "全球招募创作者 · SolHub"}
  description={metaDesc}
  route="/join/"
  locale={locale}
>
  <!-- ===== Hero ===== -->
  <section class="relative overflow-hidden border-b border-border">
    <div
      class="dot-grid pointer-events-none absolute inset-0 opacity-[0.5]"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background-image: radial-gradient(circle at 78% 12%, rgb(232 112 40 / 0.10), transparent 52%)"
    />
    <div class="container-page relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-12">
      <!-- 左：文案 + CTA -->
      <div class="text-center lg:text-left">
        <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
          {en ? "Global Creator Program" : "全球创作者计划"}
        </p>
        <h1 class="font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-foreground sm:text-5xl">
          {en ? "We're recruiting" : "全球招募"}<br />
          <span class="text-accent">{en ? "creators worldwide" : "创作者"}</span>
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-[15px] leading-7 text-muted-foreground sm:text-base lg:mx-0">
          {
            en
              ? "SolHub invites indie developers, designers and tool-makers from every corner of the world to bring their work here — a transparent, honest stage with real verification and no fake metrics, where good work actually gets seen."
              : "SolHub 正在邀请全世界的独立开发者、设计师与工具作者，把你们正在创造的产品带到这里。一个透明、真实、没有虚假流量的舞台，让好作品被真正看见。"
          }
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a href={p("/submit/", locale)} class="btn btn-accent h-11 px-6 text-[15px]">
            {en ? "Submit your product" : "提交你的产品"}
            <span aria-hidden="true">→</span>
          </a>
          <a href={p("/about/", locale)} class="btn btn-outline h-11 px-6 text-[15px]">
            {en ? "About SolHub" : "了解我们"}
          </a>
        </div>
        <p class="mt-4 text-[12.5px] text-muted-foreground/80">
          {
            en
              ? "No GitHub required — sign up with just an email."
              : "无需 GitHub，一个邮箱即可加入。"
          }
        </p>
      </div>

      <!-- 右：地球仪（世界地图元素） -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <div
            class="pointer-events-none absolute inset-0 -z-10 blur-2xl"
            aria-hidden="true"
            style="background: radial-gradient(circle at 50% 50%, rgb(232 112 40 / 0.18), transparent 60%)"
          />
          <svg
            viewBox="0 0 220 220"
            class="h-64 w-64 sm:h-72 sm:w-72"
            role="img"
            aria-label={en ? "A globe with creator pins around the world" : "一个带有世界各地创作者坐标点的地球仪"}
          >
            <defs>
              <radialGradient id="globeFill" cx="38%" cy="32%" r="75%">
                <stop offset="0%" stop-color="rgb(232 112 40 / 0.10)" />
                <stop offset="70%" stop-color="rgb(232 112 40 / 0.03)" />
                <stop offset="100%" stop-color="rgb(232 112 40 / 0)" />
              </radialGradient>
            </defs>

            <!-- 球体填充 -->
            <circle cx="110" cy="110" r="82" fill="url(#globeFill)" />
            <!-- 外圈 -->
            <circle cx="110" cy="110" r="82" fill="none" stroke="rgb(232 112 40 / 0.55)" stroke-width="1.5" />

            <!-- 经线（汇聚于两极的椭圆） -->
            <g fill="none" stroke="rgb(232 112 40 / 0.28)" stroke-width="1">
              <ellipse cx="110" cy="110" rx="82" ry="82" />
              <ellipse cx="110" cy="110" rx="56" ry="82" />
              <ellipse cx="110" cy="110" rx="30" ry="82" />
              <ellipse cx="110" cy="110" rx="8" ry="82" />
              <line x1="110" y1="28" x2="110" y2="192" />
            </g>

            <!-- 纬线（裁剪在圆内的水平线） -->
            <g stroke="rgb(232 112 40 / 0.22)" stroke-width="1">
              <line x1="28" y1="110" x2="192" y2="110" />
              <line x1="32.2" y1="84" x2="187.8" y2="84" />
              <line x1="32.2" y1="136" x2="187.8" y2="136" />
              <line x1="45" y1="60" x2="175" y2="60" />
              <line x1="45" y1="160" x2="175" y2="160" />
            </g>

            <!-- 创作者连线（流动弧线） -->
            <g fill="none" stroke="rgb(232 112 40 / 0.5)" stroke-width="1.4" class="arc">
              <path d="M76,78 Q108,40 150,100" />
              <path d="M120,66 Q142,92 132,146" />
              <path d="M96,132 Q130,152 160,124" />
            </g>

            <!-- 创作者坐标点（脉冲环 + 实心点） -->
            <g>
              <circle class="pin-ring" cx="76" cy="78" r="2" fill="none" stroke="#F08A4B" stroke-width="1.5" />
              <circle cx="76" cy="78" r="2.6" fill="#F08A4B" />
              <circle cx="76" cy="78" r="1" fill="#fff" />

              <circle class="pin-ring" cx="120" cy="66" r="2" fill="none" stroke="#F08A4B" stroke-width="1.5" style="animation-delay:.6s" />
              <circle cx="120" cy="66" r="2.6" fill="#F08A4B" />
              <circle cx="120" cy="66" r="1" fill="#fff" />

              <circle class="pin-ring" cx="150" cy="100" r="2" fill="none" stroke="#F08A4B" stroke-width="1.5" style="animation-delay:1.1s" />
              <circle cx="150" cy="100" r="2.6" fill="#F08A4B" />
              <circle cx="150" cy="100" r="1" fill="#fff" />

              <circle class="pin-ring" cx="96" cy="132" r="2" fill="none" stroke="#F08A4B" stroke-width="1.5" style="animation-delay:1.6s" />
              <circle cx="96" cy="132" r="2.6" fill="#F08A4B" />
              <circle cx="96" cy="132" r="1" fill="#fff" />

              <circle class="pin-ring" cx="132" cy="146" r="2" fill="none" stroke="#F08A4B" stroke-width="1.5" style="animation-delay:.3s" />
              <circle cx="132" cy="146" r="2.6" fill="#F08A4B" />
              <circle cx="132" cy="146" r="1" fill="#fff" />

              <circle class="pin-ring" cx="160" cy="124" r="2" fill="none" stroke="#F08A4B" stroke-width="1.5" style="animation-delay:1.9s" />
              <circle cx="160" cy="124" r="2.6" fill="#F08A4B" />
              <circle cx="160" cy="124" r="1" fill="#fff" />
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 什么是 SolHub ===== -->
  <section class="py-12 sm:py-16">
    <div class="container-page prose-solhub max-w-3xl">
      <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
        {en ? "What is SolHub" : "什么是 SolHub"}
      </p>
      <h2 class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        {
          en
            ? "A discovery platform built for indie makers"
            : "一个为独立创作者而生的发现平台"
        }
      </h2>
      <p class="mt-4">
        {
          en
            ? "SolHub is a product-discovery platform and free online toolbox built by an indie developer, for indie developers. We believe the most valuable products and tools deserve to be discovered — not buried under ads and opaque rankings. Submissions go public instantly, verification is real (the system actually checks whether your link loads), and every ranking rule is explained in the open."
            : "SolHub 是一个由独立开发者构建、为独立开发者服务的产品发现平台与在线工具箱。我们相信：真正有价值的产品和工具，值得被发现——而不是被广告和不透明的排序埋没。提交即自动公开，核验真实（系统实际检测你的链接能否打开），每一条排序规则都公开可解释。"
        }
      </p>
    </div>
  </section>

  <!-- ===== 为什么加入 ===== -->
  <section class="border-t border-border bg-secondary/30 py-12 sm:py-16">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
          {en ? "Why join" : "为什么加入"}
        </p>
        <h2 class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
          {en ? "What you get as a creator" : "作为创作者，你会得到什么"}
        </h2>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <!-- 1 -->
        <div class="card p-5">
          <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 12l2 2 4-4" /><path d="M12 3l8 4v5c0 4.5-3.2 7.6-8 9-4.8-1.4-8-4.5-8-9V7l8-4Z" />
            </svg>
          </div>
          <h3 class="font-display text-[15px] font-bold text-foreground">
            {en ? "Real verification, no fakes" : "真实核验，不靠刷量"}
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-6 text-muted-foreground">
            {
              en
                ? "Verified comes from the system actually checking that your link loads — never from fake traffic or bought votes."
                : "Verified 来自系统真实的链接可达性检测，绝不用虚构访问量或刷来的投票装饰页面。"
            }
          </p>
        </div>

        <!-- 2 -->
        <div class="card p-5">
          <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3v18h18" /><path d="M7 14l3-3 3 3 5-6" />
            </svg>
          </div>
          <h3 class="font-display text-[15px] font-bold text-foreground">
            {en ? "Transparent ranking" : "透明排序规则"}
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-6 text-muted-foreground">
            {
              en
                ? "Every ranking rule is public and explainable — no dark boxes, no pay-to-rank."
                : "每一条排序规则都公开可解释，没有暗箱，也没有付费上位。"
            }
          </p>
        </div>

        <!-- 3 -->
        <div class="card p-5">
          <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16v16H4z" /><path d="M4 7l8 6 8-6" />
            </svg>
          </div>
          <h3 class="font-display text-[15px] font-bold text-foreground">
            {en ? "Email is enough" : "邮箱即注册"}
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-6 text-muted-foreground">
            {
              en
                ? "No GitHub needed — one email lets you submit and manage your work from your personal center."
                : "无需 GitHub，一个邮箱就能提交并在个人中心管理你的作品。"
            }
          </p>
        </div>

        <!-- 4 -->
        <div class="card p-5">
          <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10 text-accent">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
            </svg>
          </div>
          <h3 class="font-display text-[15px] font-bold text-foreground">
            {en ? "Global exposure" : "全球曝光"}
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-6 text-muted-foreground">
            {
              en
                ? "Visitors from around the world discover indie work here — your product meets people you'd never reach alone."
                : "来自世界各地的访问者在这里发现独立作品，让你的产品遇见你独自无法触达的人。"
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 三步加入 ===== -->
  <section class="py-12 sm:py-16">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
          {en ? "How it works" : "三步开始"}
        </p>
        <h2 class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
          {en ? "From sign-up to live in minutes" : "从注册到上线，只需三步"}
        </h2>
      </div>

      <ol class="mt-8 grid gap-6 sm:grid-cols-3">
        <li class="card relative p-6">
          <span class="font-display text-3xl font-extrabold text-accent/30">01</span>
          <h3 class="mt-2 font-display text-base font-bold text-foreground">
            {en ? "Sign up with email" : "用邮箱注册"}
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-6 text-muted-foreground">
            {en ? "Or log in with GitHub. No approval queue." : "或直接使用 GitHub 登录，无需等待审核。"}
          </p>
        </li>
        <li class="card relative p-6">
          <span class="font-display text-3xl font-extrabold text-accent/30">02</span>
          <h3 class="mt-2 font-display text-base font-bold text-foreground">
            {en ? "Submit your link" : "提交你的产品 / 工具"}
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-6 text-muted-foreground">
            {
              en
                ? "Paste your product or tool URL and a one-line description."
                : "粘贴你的产品 / 工具链接，写一句一句话介绍。"
            }
          </p>
        </li>
        <li class="card relative p-6">
          <span class="font-display text-3xl font-extrabold text-accent/30">03</span>
          <h3 class="mt-2 font-display text-base font-bold text-foreground">
            {en ? "Go live instantly" : "即时公开 + 点亮徽章"}
          </h3>
          <p class="mt-1.5 text-[13.5px] leading-6 text-muted-foreground">
            {
              en
                ? "The system checks the link; if reachable, it's published and your verified badge lights up."
                : "系统检测链接，可访问即公开到社区列表，认证徽章自动点亮。"
            }
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ===== 开发者友好（代码元素） ===== -->
  <section class="border-t border-border bg-secondary/30 py-12 sm:py-16">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div class="min-w-0">
        <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
          {en ? "Developer-friendly" : "开发者友好"}
        </p>
        <h2 class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
          {en ? "Built by a maker, for makers" : "由一个创作者，为创作者们打造"}
        </h2>
        <p class="mt-4 text-[15px] leading-7 text-muted-foreground">
          {
            en
              ? "Prefer the command line? The whole flow is just a link away. Submit, verify and publish without leaving your workflow — and link SolHub back from your own site to bring your audience along."
              : "更喜欢命令行？整个流程只是一行链接的事。无需离开你的工作流就能提交、核验、上线——也可以在你的站点链回 SolHub，把你的读者一起带来。"
          }
        </p>
      </div>

      <div class="min-w-0 space-y-4">
        <!-- 终端 -->
        <div class="card overflow-hidden">
          <div class="flex items-center gap-1.5 border-b border-border bg-secondary/60 px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-destructive/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-warning/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-success/70"></span>
            <span class="ml-2 font-mono text-[11px] text-muted-foreground">solhub — zsh</span>
          </div>
          <pre class="scroll-x p-4 font-mono text-[12.5px] leading-6 text-foreground/85"><code><span class="text-muted-foreground">$ </span><span class="text-accent">npx</span> solhub login
  <span class="text-success">✓</span> connected to the creator network

<span class="text-muted-foreground">$ </span><span class="text-accent">solhub</span> submit
  <span class="text-muted-foreground">? </span>product url: <span class="text-accent">https://your-app.com</span>
  <span class="text-success">✓</span> link reachable → published to community feed
  <span class="text-success">✓</span> email verified → badge lit up
  <span class="text-muted-foreground">→ </span>live at solhub.solyoung.top/launches/</code></pre>
        </div>

        <!-- 嵌入代码片段 -->
        <div class="card overflow-hidden">
          <div class="flex items-center gap-1.5 border-b border-border bg-secondary/60 px-4 py-2.5">
            <span class="font-mono text-[11px] text-muted-foreground">your-site.html</span>
          </div>
          <pre class="scroll-x p-4 font-mono text-[12.5px] leading-6 text-foreground/85"><code><span class="text-muted-foreground">&lt;!-- 链回 SolHub，把你的读者带来 --&gt;</span>
<span class="text-accent">&lt;a</span> href=<span class="text-accent">"https://solhub.solyoung.top/submit/"</span><span class="text-accent">&gt;</span>
  在 SolHub 提交你的作品 →
<span class="text-accent">&lt;/a&gt;</span></code></pre>
        </div>
        <p class="text-[12px] text-muted-foreground/80">
          {
            en
              ? "The terminal above is illustrative; the real flow lives on the submit page. The snippet is copy-paste ready."
              : "上方终端为示意，真实流程在提交页完成；下方代码片段可直接复制使用。"
          }
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 分享拉新 ===== -->
  <section class="py-12 sm:py-16">
    <div class="container-page">
      <div class="card relative overflow-hidden p-7 sm:p-10">
        <div
          class="pointer-events-none absolute inset-0"
          aria-hidden="true"
          style="background-image: radial-gradient(circle at 12% 0%, rgb(232 112 40 / 0.10), transparent 45%)"
        />
        <div class="relative max-w-2xl">
          <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
            {en ? "Bring a friend" : "分享拉新"}
          </p>
          <h2 class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
            {en ? "Know a great maker? Bring them along" : "认识厉害的创作者？带 TA 一起来"}
          </h2>
          <p class="mt-3 text-[15px] leading-7 text-muted-foreground">
            {
              en
                ? "Every creator gets a personal invite link. Share it and grow the network of honest, independent work — referral rewards are on the way."
                : "每位创作者都有一条专属邀请链接。分享出去，壮大这个真诚、独立的创作网络——邀请奖励即将上线。"
            }
          </p>
        </div>
        <div class="relative mt-6">
          <RecruitShare client:load locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 最终 CTA ===== -->
  <section class="border-t border-border bg-secondary/30 py-12 sm:py-16">
    <div class="container-page text-center">
      <h2 class="font-display mx-auto max-w-2xl text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
        {
          en
            ? "Ready to let the world see what you built?"
            : "准备好让你的作品被世界看见了吗？"
        }
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-[15px] leading-7 text-muted-foreground">
        {
          en
            ? "It takes one email and a link. Join the creators already shipping on SolHub."
            : "只需要一个邮箱和一条链接。加入已经在 SolHub 上发布作品的创作者们。"
        }
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={p("/submit/", locale)} class="btn btn-accent h-11 px-6 text-[15px]">
          {en ? "Submit your product" : "提交你的产品"}
          <span aria-hidden="true">→</span>
        </a>
        <a href={p("/", locale)} class="btn btn-outline h-11 px-6 text-[15px]">
          {en ? "Back to home" : "返回首页"}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 点阵背景：呼应「代码 / 全球坐标」的科技感 */
  .dot-grid {
    background-image: radial-gradient(rgb(27 26 24 / 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -11px -11px;
  }
  :global(html.dark) .dot-grid {
    background-image: radial-gradient(rgb(243 239 233 / 0.07) 1px, transparent 1px);
  }

  /* 创作者坐标点脉冲环 */
  .pin-ring {
