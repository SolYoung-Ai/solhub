---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JoinSignup from "@/islands/JoinSignup.tsx";
import { p } from "@/lib/paths";
import { AppWindow, BadgeCheck, PackagePlus, ShieldCheck } from "lucide-react";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const features = [
  {
    icon: PackagePlus,
    title: en ? "Submit and go live" : "提交即上线",
    desc: en
      ? "If your link opens, it's listed — no queue, no review email."
      : "官网链接能正常打开就自动收录，不用排队等审核。",
  },
  {
    icon: ShieldCheck,
    title: en ? "Verification that means something" : "核验有据可查",
    desc: en
      ? "A green badge means the link was actually opened and checked."
      : "绿色核验标代表链接被真的打开检查过，不是自动盖章。",
  },
  {
    icon: BadgeCheck,
    title: en ? "Verified creator badge" : "认证创作者徽章",
    desc: en
      ? "Verify your email, then submit one product — the yellow badge lights up automatically."
      : "完成邮箱验证后提交一个产品，主页上的黄V自动点亮。",
  },
  {
    icon: AppWindow,
    title: en ? "Tools that actually run" : "工具直接在站内跑",
    desc: en
      ? "Upload a self-contained HTML tool and it runs in a sandbox here."
      : "自带 HTML 的小工具上传后直接在站内沙箱里运行，不用另找托管。",
  },
];
---

<BaseLayout
  title={en ? "Join SolHub" : "加入 SolHub"}
  description={
    en
      ? "SolHub is a product catalog and toolbox for independent makers: submit and go live, real verification, click-based ranking, and tools that run in the sandbox."
      : "SolHub 是面向独立创作者的产品目录与在线工具箱：提交即上线、核验有据可查、按真实点击排名，工具上传后直接在站内沙箱运行。"
  }
  route="/join/"
  locale={locale}
>
  <section class="py-10 sm:py-14">
    <div class="container-page">
      <div class="mx-auto grid max-w-5xl items-start gap-8 lg:grid-cols-[minmax(0,1fr)_372px] lg:gap-12">
        <!-- 左：介绍 -->
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
            {en ? "For independent makers" : "全球创作者计划"}
          </p>
          <h1 class="mt-2 font-display text-[28px] font-extrabold leading-[1.2] tracking-tight text-foreground sm:text-[36px]">
            {en ? "Good work deserves" : "让认真做的产品，"}
            <span class="block text-accent">{en ? "to be found." : "被真正看见。"}</span>
          </h1>
          <p class="mt-3 max-w-lg text-[14px] leading-7 text-muted-foreground">
            {en
              ? "SolHub is a product catalog and online toolbox for independent makers worldwide — transparent rankings, verification you can check, and tools that run right in the page."
              : "SolHub 是一个面向全球独立创作者的产品目录与在线工具箱：排名规则公开、核验能追溯到证据、工具直接在页面里运行。没有广告位竞价，也没有排队等审核。"}
          </p>

          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {features.map((f) => (
              <div class="rounded-[16px] border border-border bg-card p-4">
                <span class="flex h-8 w-8 items-center justify-center rounded-[9px] bg-accent/10 text-accent">
                  <f.icon className="h-4 w-4" aria-hidden="true" />
                </span>
                <p class="mt-2.5 text-[13.5px] font-semibold text-foreground">{f.title}</p>
                <p class="mt-1 text-[12px] leading-5 text-muted-foreground">{f.desc}</p>
              </div>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[12.5px]">
            <a href={p("/launches/", locale)} class="text-accent hover:underline">
              {en ? "Browse the catalog →" : "先逛逛产品目录 →"}
            </a>
            <a href={p("/tools/", locale)} class="text-muted-foreground hover:text-foreground">
              {en ? "Try the free toolbox" : "试用免费工具箱"}
            </a>
            <a href={p("/wallet/", locale)} class="text-muted-foreground hover:text-foreground">
              {en ? "What points are for" : "积分能干什么"}
            </a>
          </div>
        </div>

        <!-- 右：注册卡 -->
        <div id="signup" class="lg:sticky lg:top-6">
          <JoinSignup client:load locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
