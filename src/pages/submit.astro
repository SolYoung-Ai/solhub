---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubmitForm from "@/islands/SubmitForm.tsx";
import { p } from "@/lib/paths";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? "Submit your website, AI tool or Agent Skill to SolHub. Products go live once the link opens; Skills are reviewed before joining the Skill directory; self-contained HTML tools run in a sandbox."
  : "把你开发的网站、AI 工具或 Agent Skill 提交到 SolHub。产品链接可访问即自动收录；Skill 经核验后加入 Skill 库；自包含 HTML 工具在沙箱内运行。";
---

<BaseLayout
  title={en ? "Submit a Product, Skill or Tool" : "提交产品 / Skill / 工具"}
  description={metaDesc}
  route="/submit/"
  locale={locale}
>
  <section class="border-b border-border bg-secondary/30 py-8 sm:py-10">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
        Launch
      </p>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {en ? "Submit a Product, Skill or Tool" : "提交产品 / Skill / 工具"}
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">
        {en
          ? "Built a website, an AI tool or an Agent Skill? Pick the matching tab below. Product links that open are published instantly; Skills are reviewed before joining the Skill directory; self-contained HTML tools can be hosted in a sandbox right here."
          : "开发了网站、AI 工具还是 Agent Skill？下面选对应的类型提交：产品链接可访问即自动收录；Skill 经核验后加入 Skill 库；自包含 HTML 工具可托管到本站沙箱运行。"}
      </p>
      <p class="mt-3 inline-flex max-w-2xl items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-3.5 py-1.5 text-[13px] font-medium text-foreground/80">
        <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" aria-hidden="true">
          <path fill="#F08A4B" d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path>
          <path stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" fill="none" d="M8.6 12.2l2.3 2.3 4.5-4.5"></path>
        </svg>
        {en
          ? "Submit a product with a verified email — your verified badge lights up automatically."
          : "提交产品并完成邮箱验证，认证徽章自动点亮。"}
      </p>
    </div>
  </section>

  <section class="py-8 sm:py-12">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_280px]">
      <div>
        <SubmitForm client:load locale={locale} />
      </div>
      <aside class="space-y-4">
        <div class="card p-5">
          <h2 class="text-sm font-bold text-foreground">{en ? "Submission flow" : "提交流程"}</h2>
          <ol class="mt-3 space-y-3 text-[13px] leading-6 text-muted-foreground">
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">01</span>
              {en ? "Log in (only needed for one-click product publishing)" : "按需登录（产品一键收录需要，Skill 提交可跳过）"}
            </li>
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">02</span>
              {en ? "Fill in the fields for the type you picked" : "按所选类型填写信息"}
            </li>
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">03</span>
              {en ? "Products go live instantly; Skills are reviewed" : "产品链接通过即上线；Skill 人工核验后收录"}
            </li>
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">04</span>
              {en ? "Manage anytime — edit or delete in My Account" : "随时在「个人中心」编辑或删除"}
            </li>
          </ol>
          <p class="mt-3 border-t border-border pt-3 text-xs leading-5 text-muted-foreground">
            {en
              ? "Products need no manual review — as long as the link opens, they are published. Skills are reviewed before listing. Illegal, infringing or malicious content will be removed."
              : "产品无需人工审核：链接可正常打开即自动收录；Skill 需核验后收录。违法违规、侵权或夹带恶意指令的内容会被下架。"}
          </p>
        </div>
        <div class="card p-5">
          <h2 class="text-sm font-bold text-foreground">{en ? "Listing criteria" : "收录标准"}</h2>
          <ul class="mt-2 space-y-1.5 text-[13px] leading-6 text-muted-foreground">
            <li>· {en ? "Official site opens publicly" : "官网可公开访问"}</li>
            <li>· {en ? "Info is real and complete" : "产品信息真实完整"}</li>
            <li>· {en ? "Original, no infringing content" : "原创产品，无侵权内容"}</li>
            <li>· {en ? "Ready to use, not a placeholder" : "已可正常使用，非半成品"}</li>
          </ul>
        </div>
        <div class="card border-accent/25 p-5">
          <h2 class="flex items-center gap-2 text-sm font-bold text-foreground">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 1.9 4.6L19 9.5l-4.2 2.6L14 17l-2-4.9L7 9.5l5.1-1.9L12 3Z" /></svg>
            {en ? "Skill listing criteria" : "Skill 收录标准"}
          </h2>
          <ul class="mt-2 space-y-1.5 text-[13px] leading-6 text-muted-foreground">
            <li>· {en ? "Public repo or skills.sh page" : "仓库 / skills.sh 页面公开可访问"}</li>
            <li>· {en ? "Complete SKILL.md with trigger scenarios" : "含完整 SKILL.md 与触发场景"}</li>
            <li>· {en ? "Installable, not an empty placeholder" : "可安装运行，不是空壳"}</li>
            <li>· {en ? "Properly licensed, no malicious instructions" : "协议合规，无恶意指令"}</li>
          </ul>
          <a href={p("/skills/", locale)} class="mt-3 inline-flex items-center gap-1 text-[12px] font-medium text-accent hover:underline">
            {en ? "Browse Skill directory ↗" : "查看 Skill 库 ↗"}
          </a>
        </div>
        <div class="card p-5">
          <h2 class="text-sm font-bold text-foreground">{en ? "Modify or delete" : "修改或删除"}</h2>
          <p class="mt-2 text-[13px] leading-6 text-muted-foreground">
            {en
              ? "Logged in? Edit or delete your products anytime from My Account — no email needed."
              : "登录用户在「个人中心」即可随时编辑或删除自己收录的产品，无需发邮件。"}
          </p>
          <p class="mt-2 text-[13px] leading-6 text-muted-foreground">
            {en
              ? "Submitted via email? Email soyoang@outlook.com from the same address with your product or Skill name — processed within 24 hours."
              : "邮件提交的用户：用提交时的邮箱发邮件到 soyoang@outlook.com 并注明产品或 Skill 名称，24 小时内处理。"}
          </p>
          <p class="mt-2 text-[13px] leading-6 text-muted-foreground">
            {en
              ? "Listed Skills are maintained by the same email channel — just tell us what to change or remove."
              : "Skill 库中的条目如需修改或下架，同样用提交时的邮箱发邮件说明即可。"}
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
