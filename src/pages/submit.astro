---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubmitForm from "@/islands/SubmitForm.tsx";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const metaDesc = en
  ? "Submit your website, software, AI tool or self-contained HTML tool to SolHub. Submissions are auto-published to the community list; hosted tools run in a sandbox."
  : "把你开发的网站、软件、AI 工具或自包含 HTML 工具提交到 SolHub。提交即自动公开到社区列表；托管工具在沙箱内运行。";
---

<BaseLayout
  title={en ? "Submit a Product" : "提交产品与工具"}
  description={metaDesc}
  route="/submit/"
  locale={locale}
>
  <section class="border-b border-border bg-secondary/30 py-10 sm:py-14">
    <div class="container-page">
      <p class="mb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-accent">
        Launch
      </p>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        {en ? "Submit Your Product or Tool" : "提交你的产品与工具"}
      </h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted-foreground">
        {en
          ? "If you built a website, app or AI tool, submit it to SolHub. Log in and submit — as long as your link opens, the product goes live on the community list automatically. Self-contained HTML tools can be hosted and run in a sandbox here."
          : "如果你开发了网站、软件或 AI 工具，欢迎提交到 SolHub。登录后提交：官网链接可正常打开即自动收录上线，无需等待审核；自包含 HTML 工具可以直接托管，在本站沙箱内运行。"}
      </p>
    </div>
  </section>

  <section class="py-8 sm:py-12">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_280px]">
      <div>
        <SubmitForm client:load locale={locale} />
      </div>
      <aside class="space-y-4">
        <div class="card p-5">
          <h2 class="text-sm font-bold text-foreground">{en ? "Submission flow" : "提交流程"}</h2>
          <ol class="mt-3 space-y-3 text-[13px] leading-6 text-muted-foreground">
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">01</span>
              {en ? "Log in (email + password, 10 seconds)" : "登录账号（邮箱 + 密码，10 秒注册）"}
            </li>
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">02</span>
              {en ? "Fill in the details" : "填写产品信息"}
            </li>
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">03</span>
              {en ? "Link check passes — live instantly" : "链接检测通过，产品立即上线展示"}
            </li>
            <li class="flex gap-2.5">
              <span class="font-display shrink-0 text-accent">04</span>
              {en ? "Manage anytime — edit or delete in My Account" : "随时在「个人中心」编辑或删除"}
            </li>
          </ol>
          <p class="mt-3 border-t border-border pt-3 text-xs leading-5 text-muted-foreground">
            {en
              ? "No manual review — as long as the link opens, it's published. Illegal or infringing content will be removed."
              : "无需人工审核：只要链接可正常打开就自动收录上线；违法违规或侵权内容会被下架。"}
          </p>
        </div>
        <div class="card p-5">
          <h2 class="text-sm font-bold text-foreground">{en ? "Listing criteria" : "收录标准"}</h2>
          <ul class="mt-2 space-y-1.5 text-[13px] leading-6 text-muted-foreground">
            <li>· {en ? "Official site opens publicly" : "官网可公开访问"}</li>
            <li>· {en ? "Info is real and complete" : "产品信息真实完整"}</li>
            <li>· {en ? "Original, no infringing content" : "原创产品，无侵权内容"}</li>
            <li>· {en ? "Ready to use, not a placeholder" : "已可正常使用，非半成品"}</li>
          </ul>
        </div>
        <div class="card p-5">
          <h2 class="text-sm font-bold text-foreground">{en ? "Modify or delete" : "修改或删除"}</h2>
          <p class="mt-2 text-[13px] leading-6 text-muted-foreground">
            {en
              ? "Logged in? Edit or delete your products anytime from My Account — no email needed."
              : "登录用户在「个人中心」即可随时编辑或删除自己收录的产品，无需发邮件。"}
          </p>
          <p class="mt-2 text-[13px] leading-6 text-muted-foreground">
            {en
              ? "Submitted via email? Email soyoang@outlook.com from the same address with your product name — processed within 24 hours."
              : "邮件提交的用户：用提交时的邮箱发邮件到 soyoang@outlook.com 并注明产品名称，24 小时内处理。"}
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
