---
import { baseUrl } from "@/lib/paths";
import "../styles/global.css";

const base = baseUrl();
const pathname = Astro.url.pathname;
const en = pathname.includes("/en/") || pathname.endsWith("/en");
---

<!doctype html>
<html lang={en ? "en" : "zh-CN"} class="theme-init">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="solhub-base" content={base} />
    <title>{en ? "Page not found" : "页面不存在"} · SolHub</title>
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />

    <!--
      创作者短链接兜底。
      GitHub Pages 是纯静态托管，不存在 /@<handle> 这个文件，请求会落到本 404 页。
      在 React 水合之前同步重定向到独立展示页 /u/?h=<handle>，
      既拿到干净的 200 页面，地址栏也不会停在 404 上。
      支持：/@handle、/u/handle、/en/@handle，以及 ?lang=en。
    -->
    <script is:inline>
      (function () {
        try {
          var base = "/";
          var meta = document.querySelector('meta[name="solhub-base"]');
          if (meta) base = meta.getAttribute("content") || "/";

          var path = location.pathname;
          /* 去掉 base 前缀（项目站点部署时形如 /solhub/@handle） */
          if (base !== "/" && path.indexOf(base) === 0) {
            path = "/" + path.slice(base.length);
          }

          /* 可选 /en 前缀：让 /en/@handle 也能正确落到英文展示页 */
          var enPath = false;
          if (path.indexOf("/en/") === 0) {
            enPath = true;
            path = path.slice(3);
          }

          var m = path.match(/^\/@([^/?#]+)\/?$/) || path.match(/^\/u\/([^/?#]+)\/?$/);
          if (!m || !m[1]) return;

          var handle = decodeURIComponent(m[1]);
          var lang = enPath ? "en" : "zh";
          try {
            var q = new URLSearchParams(location.search);
            if (q.get("lang") === "en") lang = "en";
            else if (!enPath && localStorage.getItem("solhub:lang") === "en") lang = "en";
          } catch (e) {}

          var target = base + (lang === "en" ? "en/" : "") + "u/?h=" + encodeURIComponent(handle);
          location.replace(target);
        } catch (e) { /* 兜底：留在 404 页 */ }

        /* 主题：避免短链接跳转前白屏闪烁 */
        try {
          var t = localStorage.getItem("solhub:theme");
          if (t !== "light") {
            document.documentElement.classList.add("dark");
          }
          document.documentElement.classList.remove("theme-init");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <div class="container-page flex flex-col items-center py-28 text-center">
      <p class="font-display text-7xl font-extrabold tracking-tight text-accent" aria-hidden="true">404</p>
      <h1 class="font-display mt-4 text-2xl font-bold text-foreground">
        {en ? "This page doesn't exist" : "这个页面不存在"}
      </h1>
      <p class="mt-2 max-w-md text-sm leading-6 text-muted-foreground">
        {en
          ? "The link may be broken, or the page has moved. Head back home, or go discover some products and tools."
          : "链接可能已失效，或者页面被移动了。你可以回到首页，或者去发现一些产品和工具。"}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={base} class="btn btn-primary">{en ? "Back to home" : "回到首页"}</a>
        <a href={`${base}launches/`} class="btn btn-outline">{en ? "Explore products" : "浏览产品"}</a>
      </div>
    </div>
  </body>
</html>
