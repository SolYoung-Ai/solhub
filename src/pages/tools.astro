---
/**
 * 托管工具详情页（/tools/?id=xxxx）
 * ================================
 *
 * 和 /products/<slug>/ 用同一套版式：图标 + 名称 + 一句话 + 关于 + 标签 + 主按钮，
 * 侧栏是核验状态 / 分类 / 开发者 / 收录时间。区别只有一个：
 * 主按钮是「访问工具」，点了才在页面下方展开沙箱 iframe 运行工具本体。
 *
 * 数据来源：GET /hosted/meta/<id>（元信息）；工具本体 GET /hosted/<id> 在点击时才拉。
 *
 * 三层隔离（与之前一致）：
 *   1. iframe 的 sandbox 不给 allow-same-origin —— 工具页是不透明 origin；
 *   2. 云函数响应带 CSP: sandbox，双保险；
 *   3. API 域名与主站不同源。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { p } from "@/lib/paths";
import { productCategories } from "@/data/product-categories";
import { productCatEn } from "@/i18n/data";
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

/* 分类 slug → 显示名：托管工具的分类存在云端，页面是静态的，只能在前端查表 */
const catNames: Record<string, string> = {};
for (const c of productCategories) {
  catNames[c.slug] = en ? (productCatEn[c.slug]?.name ?? c.name) : c.name;
}

const copy = {
  crumb: en ? "Products" : "产品",
  missing: en ? "This tool doesn't exist or has been removed." : "工具不存在或已被删除。",
  invalid: en ? "Invalid tool link." : "工具链接无效。",
  loadFail: en ? "Failed to load. Please retry." : "加载失败，请稍后重试。",
  aboutTitle: en ? "About this tool" : "关于这个工具",
  aboutFallback: en
    ? "Uploaded as a single self-contained HTML file. Everything runs inside the tool's own sandboxed frame on SolHub — the tool can't read SolHub cookies, localStorage or your account data."
    : "以单个自包含 HTML 文件上传。工具在 SolHub 的独立沙箱 iframe 内运行，读不到 SolHub 的 Cookie、localStorage 与你的账号数据。",
  visit: en ? "Open tool" : "访问工具",
  /* 全屏运行页（左侧留导航、右侧整块跑工具） */
  playBase: p("/tools/play/", locale),
  collapse: en ? "Close tool" : "收起工具",
  running: en ? "Running in sandbox" : "沙箱内运行中",
  verification: en ? "Verification status" : "核验状态",
  verificationText: en
    ? "This tool was uploaded by a community member. SolHub verified automatically that the file loads and runs inside the sandbox, and that its name and description match its content. This is not an editorial review of what the tool does — please judge before use."
    : "该工具由社区成员上传。SolHub 已完成系统自动核验：文件可在沙箱内正常加载运行，名称与描述与内容一致。该状态不代表 SolHub 人工审查了工具内容，请自行判断后使用。",
  verificationTextOfficial: en
    ? "This tool is built and maintained by SolHub. It runs in the same isolated sandbox as every hosted tool — it can't read your SolHub account, cookies or localStorage."
    : "该工具由 SolHub 官方开发维护。它与其他托管工具一样运行在独立沙箱中，读不到你的账号数据、Cookie 与本地存储。",
  verifiedAt: en ? "Checked at" : "核验时间",
  method: en ? "Method" : "核验方式",
  methodAuto: en ? "Automatic (sandbox run)" : "系统自动核验（沙箱运行）",
  category: en ? "Category" : "分类",
  developer: en ? "Uploader" : "上传者",
  communityUser: en ? "Community member" : "社区用户",
  addedAt: en ? "Added" : "收录时间",
  ctaTitle: en ? "Host your own tool" : "托管你自己的工具",
  ctaText: en
    ? "Upload a single self-contained HTML file — it goes live immediately and shows up in the product list."
    : "上传一个自包含的 HTML 文件即可，立即上线并出现在产品列表里。",
  ctaBtn: en ? "Upload a tool" : "上传工具",
};
---

<BaseLayout
  title={en ? "Hosted tool" : "托管工具"}
  description={en ? "A community-built tool running in a sandbox on SolHub." : "社区上传的工具，在 SolHub 沙箱内运行。"}
  route="/tools/"
  locale={locale}
>
  <div class="container-page py-10">
    <!-- 面包屑 -->
    <nav class="mb-6 flex items-center gap-1.5 text-xs text-muted-foreground" aria-label={en ? "Breadcrumb" : "面包屑"}>
      <a href={p("/", locale)} class="hover:text-foreground">Home</a>
      <span aria-hidden="true">/</span>
      <a href={p("/launches/", locale)} class="hover:text-foreground">{copy.crumb}</a>
      <span aria-hidden="true">/</span>
      <span id="tool-crumb" class="truncate text-foreground/80">{en ? "Loading…" : "加载中…"}</span>
    </nav>

    <!-- 加载中 -->
    <div id="tool-loading" class="flex min-h-[40vh] flex-col items-center justify-center gap-3 text-center">
      <div class="h-6 w-6 animate-spin rounded-full border-2 border-border border-t-accent" role="status" aria-label={en ? "Loading" : "加载中"}></div>
      <p class="text-[13px] text-muted-foreground">{en ? "Loading tool…" : "正在加载工具…"}</p>
    </div>

    <!-- 不存在 -->
    <div id="tool-missing" class="card hidden p-10 text-center">
      <p id="tool-missing-text" class="text-sm text-foreground/70">{copy.missing}</p>
      <a href={p("/launches/", locale)} class="btn btn-outline mt-4 !h-9 px-3 text-xs">{en ? "Back to products" : "返回产品列表"}</a>
    </div>

    <div id="tool-content" class="hidden grid gap-10 lg:grid-cols-[1fr_300px]">
      <!-- 主栏 -->
      <article>
        <div class="flex items-start gap-4">
          <img id="tool-logo" alt="" class="hidden h-16 w-16 shrink-0 rounded-[16px] border border-border bg-card object-cover" />
          <span id="tool-logo-fallback" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-[16px] border border-border bg-secondary text-foreground/60" aria-hidden="true">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="M10 4v4"></path>
              <path d="M2 8h20"></path>
              <path d="M6 4v4"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <h1 id="tool-name" class="font-display text-3xl font-extrabold tracking-tight text-foreground"></h1>
            <p id="tool-desc" class="mt-2 text-[15px] leading-7 text-muted-foreground"></p>
            <div id="tool-badges" class="mt-3 flex flex-wrap items-center gap-2">
              <span class="badge border-border-strong bg-secondary/60 text-muted-foreground">{en ? "Online tool" : "在线工具"}</span>
              <span id="tool-category-badge" class="badge border-border-strong bg-secondary/60 text-muted-foreground">—</span>
              <span class="badge inline-flex items-center gap-1 border-success/30 bg-success/10 text-success">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
                Verified
              </span>
            </div>
          </div>
        </div>

        <div class="mt-8">
          <h2 class="font-display text-lg font-bold text-foreground">{copy.aboutTitle}</h2>
          <p id="tool-about" class="prose-solhub mt-3 whitespace-pre-line"></p>
        </div>

        <div id="tool-tags" class="mt-8 flex flex-wrap gap-2"></div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {/* 主按钮直接进「全屏使用」页（左侧仍有站点导航，右侧整块是工具） */}
          <a id="tool-full" href="#" class="btn btn-primary !h-11 w-full">
            {en ? "Use full screen" : "全屏使用"}
          </a>
          <a href={p("/submit/?type=hosted", locale)} class="btn btn-outline !h-11 w-full">
            {en ? "Upload your own" : "上传我的工具"}
          </a>
        </div>

        <!-- 工具本体：进页面就自动在沙箱里跑，不用再点一次 -->
        <section id="tool-runner" class="mt-8">
          <div class="mb-3 flex items-center justify-between gap-3">
            <h2 class="font-display text-lg font-bold text-foreground">{copy.running}</h2>
            <span class="flex items-center gap-3 text-[12px] text-muted-foreground">
              <a id="tool-direct" href="#" target="_blank" rel="noopener noreferrer" class="underline-offset-2 hover:text-accent hover:underline">
                {en ? "Open full screen" : "全屏打开"}
              </a>
              <button id="tool-collapse" type="button" class="underline-offset-2 hover:text-accent hover:underline">
                {copy.collapse}
              </button>
            </span>
          </div>
          <div class="relative overflow-hidden rounded-[10px] border border-border bg-white">
            <div id="tool-status" class="flex min-h-[50vh] flex-col items-center justify-center gap-3 text-center">
              <div id="tool-spinner" class="h-6 w-6 animate-spin rounded-full border-2 border-border border-t-accent" role="status" aria-label={en ? "Loading" : "加载中"}></div>
              <p id="tool-status-text" class="text-[13px] text-muted-foreground">{en ? "Loading tool…" : "正在加载工具…"}</p>
            </div>
            <iframe
              id="tool-frame"
              class="hidden h-[70dvh] w-full border-0 bg-white"
              title={en ? "Hosted tool" : "托管工具"}
              referrerpolicy="no-referrer"
            ></iframe>
          </div>
        </section>

        <noscript>
          <p class="mt-6 text-[13px] text-muted-foreground">{en ? "This page needs JavaScript to load and run the tool." : "加载并运行工具需要启用 JavaScript。"}</p>
        </noscript>
      </article>

      <!-- 侧栏 -->
      <aside class="space-y-5 lg:pt-1">
        <div class="card p-5">
          <h2 class="flex items-center gap-2 text-sm font-bold text-foreground">
            <svg class="h-4 w-4 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
            {copy.verification}
          </h2>
          <div class="mt-3">
            <span class="badge inline-flex items-center gap-1 border-success/30 bg-success/10 text-success">Verified</span>
          </div>
          <p id="tool-verification-text" class="mt-3 text-[13px] leading-6 text-muted-foreground">{copy.verificationText}</p>
          <p class="mt-3 border-t border-border pt-3 text-xs text-muted-foreground">
            {copy.verifiedAt}：<span id="tool-verified-at">—</span>
            <br />
            {copy.method}：{copy.methodAuto}
          </p>
        </div>

        <dl class="card divide-y divide-border p-5 text-sm">
          <div class="flex items-center justify-between gap-3 py-2">
            <dt class="text-muted-foreground">{copy.category}</dt>
            <dd id="tool-category" class="font-medium text-foreground">—</dd>
          </div>
          <div class="flex items-center justify-between gap-3 py-2">
            <dt class="text-muted-foreground">{copy.developer}</dt>
            <dd id="tool-dev" class="font-medium text-foreground">{copy.communityUser}</dd>
          </div>
          <div class="flex items-center justify-between gap-3 py-2">
            <dt class="text-muted-foreground">{copy.addedAt}</dt>
            <dd id="tool-date" class="font-medium text-foreground">—</dd>
          </div>
        </dl>

        <div class="card p-5">
          <p class="text-[13px] font-bold text-foreground">{copy.ctaTitle}</p>
          <p class="mt-2 text-[13px] leading-6 text-muted-foreground">{copy.ctaText}</p>
          <a href={p("/submit/?type=hosted", locale)} class="btn btn-accent mt-3 w-full !h-9">{copy.ctaBtn}</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="tool-labels" set:html={JSON.stringify({ catNames, copy })}></script>
<script is:inline>
  (function () {
    var labelsEl = document.getElementById("tool-labels");
    var labels = labelsEl && labelsEl.textContent ? JSON.parse(labelsEl.textContent) : {};
    var catNames = labels.catNames || {};
    var copy = labels.copy || {};
    var params = new URLSearchParams(location.search);
    var id = (params.get("id") || "").trim();
    var el = function (s) { return document.getElementById(s); };
    var loading = el("tool-loading");
    var content = el("tool-content");
    var missing = el("tool-missing");
    var runner = el("tool-runner");
    var frame = el("tool-frame");
    var statusBox = el("tool-status");
    var statusText = el("tool-status-text");
    var spinner = el("tool-spinner");
    var collapseBtn = el("tool-collapse");
    var loaded = false;

    function fail(msg) {
      loading.classList.add("hidden");
      content.classList.add("hidden");
      missing.classList.remove("hidden");
      el("tool-crumb").textContent = "—";
      el("tool-missing-text").textContent = msg || copy.missing;
    }

    if (!/^[a-z0-9]{4,16}$/.test(id)) {
      fail(copy.invalid);
      return;
    }

    var baseEl = document.querySelector('meta[name="solhub-api-base"]');
    var base = ((baseEl && baseEl.content) ||
      "https://solyoung-d4gpp1f7s4e075f6d-1499756427.ap-shanghai.app.tcloudbase.com/api").replace(/\/$/, "");
    var metaUrl = base + "/hosted/meta/" + id;
    var htmlUrl = base + "/hosted/" + id;

    /* 工具本体：进页面就自动拉一次。CloudBase 网关对 text/html 强制
       content-disposition: attachment，iframe 导航会变下载，所以 fetch 取文本塞 srcdoc。 */
    function loadTool() {
      if (loaded) return;
      fetch(htmlUrl, { credentials: "omit" }).then(function (res) {
        if (!res.ok) throw new Error(String(res.status));
        return res.text();
      }).then(function (html) {
        if (!/<[a-z]/i.test(html)) throw new Error("empty");
        frame.setAttribute("sandbox", "allow-scripts allow-forms allow-popups allow-modals");
        frame.srcdoc = html;
        frame.addEventListener("load", function () {
          statusBox.classList.add("hidden");
          frame.classList.remove("hidden");
        });
        loaded = true;
      }).catch(function (err) {
        if (spinner) spinner.classList.add("hidden");
        statusText.textContent = err && err.message === "404" ? copy.missing : copy.loadFail;
      });
    }

    /* 收起 / 展开：只是把运行区折叠起来方便读上面的介绍，工具本身不卸载 */
    collapseBtn.addEventListener("click", function () {
      var hidden = runner.classList.toggle("hidden");
      collapseBtn.textContent = hidden ? copy.visit : copy.collapse;
      if (!hidden) runner.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    fetch(metaUrl, { credentials: "omit" }).then(function (res) {
      if (!res.ok) throw new Error(String(res.status));
      return res.json();
    }).then(function (data) {
      var t = data && data.tool;
      if (!t || !t.name) throw new Error("empty");
      loading.classList.add("hidden");
      content.classList.remove("hidden");

      /* 托管工具只有一个描述字段：头部取首句当一句话（按标点切，避免把
         "SVG" 这类词切成 "SV…"），「关于」区放完整描述 + 运行方式说明。 */
      var desc = (t.description || "").trim();
      var cut = desc.search(/[。！？!?；;，,]/);
      var firstSentence = cut > 0 ? desc.slice(0, cut) : desc;
      var headline = firstSentence.length <= 46 ? firstSentence : desc.slice(0, 44) + "…";
      document.title = t.name + " · SolHub";
      el("tool-crumb").textContent = t.name;
      el("tool-name").textContent = t.name;
      el("tool-desc").textContent = headline;
      el("tool-about").textContent = desc ? desc + "\n\n" + copy.aboutFallback : copy.aboutFallback;

      var catName = catNames[t.category] || t.category || "—";
      el("tool-category").textContent = catName;
      el("tool-category-badge").textContent = catName;
      el("tool-date").textContent = (t.createdAt || "").slice(0, 10) || "—";
      el("tool-verified-at").textContent = (t.createdAt || "").slice(0, 10) || "—";

      if (t.logoUrl) {
        var logo = el("tool-logo");
        logo.src = t.logoUrl;
        logo.classList.remove("hidden");
        el("tool-logo-fallback").classList.add("hidden");
      }

      if (t.ownerHandle) {
        var dev = el("tool-dev");
        var a = document.createElement("a");
        a.href = "/world/?u=" + encodeURIComponent(t.ownerHandle);
        a.className = "hover:text-accent";
        a.textContent = "@" + t.ownerHandle;
        dev.textContent = "";
        dev.appendChild(a);
      } else if (t.author) {
        el("tool-dev").textContent = t.author;
      }

      if (t.author && copy.verificationTextOfficial) {
        el("tool-verification-text").textContent = copy.verificationTextOfficial;
      }

      var tagsEl = el("tool-tags");
      (t.tags || []).forEach(function (tag) {
        var span = document.createElement("span");
        span.className = "badge border-border bg-secondary/50 text-muted-foreground";
        span.textContent = "#" + tag;
        tagsEl.appendChild(span);
      });

      /* 全屏使用：/tools/play/?id=xxx —— 左侧保留站点导航，右侧整块都是工具。
         不能直指 /hosted/<id>（网关会强制下载 HTML 而不是渲染）。 */
      var playUrl = copy.playBase + "?id=" + encodeURIComponent(id);
      el("tool-full").href = playUrl;
      el("tool-direct").href = playUrl;

      /* 进页面直接在沙箱里跑，不用再点一次 */
      loadTool();
    }).catch(function (err) {
      fail(err && err.message === "404" ? copy.missing : copy.loadFail);
    });
  })();
</script>
