---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/data/site";
import { products } from "@/data/products";
import { categories } from "@/data/categories";
import { rankProducts } from "@/lib/ranking";
import { getIcon } from "@/lib/icons";
import { p } from "@/lib/paths";
import ProductCard from "@/components/ProductCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import HeroSearch from "@/islands/HeroSearch.tsx";
import Typewriter from "@/islands/Typewriter.tsx";
import LaunchesExplorer from "@/islands/LaunchesExplorer.tsx";
import type { Locale } from "@/i18n";
import { categoryDescription } from "@/i18n/data";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "zh";
const en = locale === "en";

const featured = rankProducts(products).slice(0, 3);
const newLaunches = rankProducts(products).slice(3, 7);

const metaTitle = en ? `${siteConfig.name} — Discover. Build. Share.` : siteConfig.name;
const metaDesc = en
  ? "Products worth discovering, tools worth using. SolHub is an indie-product discovery platform and free online toolbox: explore what indie developers are building and use simple, practical, free tools."
  : "值得被发现的产品，值得被使用的工具。SolHub 是独立产品发现平台与在线工具箱：探索独立开发者正在创造的产品，使用简单、实用、免费的在线工具，让独立创作更高效。";
---

<BaseLayout
  title={metaTitle}
  description={metaDesc}
  route="/"
  locale={locale}
>
  <!-- ===== Hero ===== -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background-image: radial-gradient(circle at 50% 0%, rgb(232 112 40 / 0.08), transparent 55%)"
    />
    <div class="container-page relative py-12 text-center sm:py-20">
      <p class="mb-3 font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-accent sm:mb-4 sm:text-[11px]">
        SolHub · Discover · Build · Share
      </p>
      {/* 语义上用 h1：这是首页唯一的一句主标题，爬虫与读屏都靠它判断页面主题。
          字号/行高全部由 class 固定，换成 h1 不会改变视觉大小。 */}
      <h1
        class={`mx-auto mt-2 max-w-2xl text-[15px] leading-7 text-muted-foreground sm:text-base ${
          en ? "min-h-[5.25rem] sm:min-h-[3.5rem]" : "min-h-[3.5rem]"
        }`}
      >
        {/* 文案逐字「打」出来；min-h 预留两行高度，避免打字过程中把下方搜索框顶来顶去 */}
        <Typewriter
          client:load
          lines={
            en
              ? [
                  "Explore products indie developers are building, use simple, practical, free online tools, ",
                  "and ship every good idea faster.",
                ]
              : ["探索独立开发者正在创造的产品，使用简单、实用、免费的在线工具，", "让每一个好想法更快落地。"]
          }
          speed={en ? 10 : 14}
          punctuationPause={60}
          startDelay={100}
        />
      </h1>
      {/* 无 JS 时把 sr-only 的完整文案放出来（此时不会打字） */}
      <noscript>
        <style is:inline>
          .tw-sr{position:static;width:auto;height:auto;margin:0;padding:0;overflow:visible;clip:auto;clip-path:none;white-space:normal;border:0}
        </style>
      </noscript>

      <div class="mx-auto mt-8 max-w-xl">
        <HeroSearch client:load locale={locale} />
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={p("/launches/", locale)} class="btn bg-accent/10 text-accent hover:bg-accent/15 border border-accent/20">
          {en ? "Explore All Products" : "浏览全部产品"}
        </a>
      </div>
    </div>
  </section>

  <!-- ===== 本周精选产品 ===== -->
  <section class="border-t border-border bg-secondary/30 py-10 sm:py-16">
    <div class="container-page">
      <SectionHeading
        eyebrow={en ? "Recent · All Products" : "近期 · 全部产品"}
        title={en ? "Recent product launches" : "近期全部产品"}
        description={en
          ? "Products worth your attention recently. Ranked by curation + verification priority; full rules on the launches page."
          : "近期值得关注的产品。排序为人工精选 + 核验优先，完整规则见产品页。"}
        actionHref={p("/launches/", locale)}
        actionLabel={en ? "View all products" : "查看全部产品"}
      />
      <div class="grid gap-5 md:grid-cols-3">
        {
          featured.map((product, i) => (
            <div class="animate-rise" style={`animation-delay:${i * 60}ms`}>
              <ProductCard product={product} rank={i + 1} highlight={true} locale={locale} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== 全部产品 ===== -->
  <section class="border-t border-border bg-secondary/30 py-10 sm:py-16">
    <div class="container-page">
      <SectionHeading
        eyebrow="All Products"
        title={en ? "All products" : "全部产品"}
        description={en
          ? "Products and tools submitted by indie developers — verified within 24 hours."
          : "独立开发者提交的产品和工具，24 小时内完成核验。"}
        actionHref={p("/launches/", locale)}
        actionLabel={en ? "View all products" : "查看全部产品"}
      />
      <LaunchesExplorer client:load products={products} locale={locale} />
    </div>
  </section>

  <!-- ===== 提交引导 ===== -->
  <section class="py-10 sm:py-16">
    <div class="container-page">
      <div class="card relative overflow-hidden p-8 text-center sm:p-12">
        <div
          class="pointer-events-none absolute inset-0"
          aria-hidden="true"
          style="background-image: radial-gradient(circle at 80% 20%, rgb(232 112 40 / 0.1), transparent 50%)"
        />
        <h2 class="font-display relative text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
          {en ? "Built a website, an AI tool or a Skill?" : "做了网站、AI 工具还是 Skill？"}
        </h2>
        <p class="relative mx-auto mt-3 max-w-xl text-sm leading-6 text-muted-foreground sm:text-[15px]">
          {en
            ? "Built a website, an AI tool or an Agent Skill? Submit it to SolHub and let more developers find it. Product links that open are published instantly; Skills are reviewed for the Skill directory; self-contained HTML tools run in our sandbox."
            : "做了网站、AI 工具还是 Agent Skill？提交到 SolHub，让更多开发者与使用者发现它。产品链接可访问即自动收录；Skill 经核验后加入 Skill 库；自包含 HTML 工具可在本站沙箱内运行。"}
        </p>
        <p class="relative mx-auto mt-3 inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-3.5 py-1.5 text-[13px] font-medium text-foreground/80">
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" aria-hidden="true">
            <path fill="#F08A4B" d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path>
            <path stroke="#fff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" fill="none" d="M8.6 12.2l2.3 2.3 4.5-4.5"></path>
          </svg>
          {en
            ? "Submit with a verified email — your verified badge lights up automatically."
            : "提交产品并完成邮箱验证，认证徽章自动点亮。"}
        </p>
        <div class="relative mt-6 flex flex-wrap items-center justify-center gap-2">
          <a href={p("/submit/", locale)} class="btn btn-accent !h-10 px-6">
            {en ? "Submit a Product" : "提交你的产品"}
            <span aria-hidden="true">→</span>
          </a>
          <a href={p("/submit/?type=skill", locale)} class="btn btn-outline !h-10 px-5">
            {en ? "Submit a Skill" : "提交 Skill"}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
